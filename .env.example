DB_NAME=xianyu2
DB_USERNAME=xianyu2
DB_PASSWORD=change-me-database-password
DB_ROOT_PASSWORD=change-me-root-password
JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_EXPIRATION_MS=28800000
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-admin-password
ALLOWED_ORIGINS=http://localhost:12400
TRUST_PROXY=false
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
JAVA_OPTS=-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=20 -XX:+ExitOnOutOfMemoryError
UPDATE_RELEASE_API=https://api.github.com/repos/Daki-l/XianYu2/releases/latest
# 首发演练期间保持 false；仅在宿主机完成验证后改为 true，应用内无法自行开启。
UPDATE_ENABLED=false
# 生产镜像由 /etc/xianyu2/release.env（或部署目录的 release.env）提供。
# 本地开发使用 docker compose -f compose.yaml -f compose.dev.yaml up --build。
TZ=Asia/Shanghai
