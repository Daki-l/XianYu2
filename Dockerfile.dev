# syntax=docker/dockerfile:1.7

# 仅供本地开发和 CI 非发行构建使用；正式镜像使用 Dockerfile 并接收预构建 JAR。
ARG PLAYWRIGHT_BASE_IMAGE=ghcr.io/daki-l/xianyu2-playwright:v1.61.0
ARG APP_VERSION=0.0.0-dev
ARG RUNTIME_FINGERPRINT=jre-21-playwright-1.61.0

FROM node:20-alpine AS frontend-build
ARG APP_VERSION
WORKDIR /app/vue-code
COPY vue-code/package.json vue-code/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY vue-code/ ./
RUN APP_VERSION="${APP_VERSION}" npm run type-check && APP_VERSION="${APP_VERSION}" npm run build:spring

FROM eclipse-temurin:21-jdk-jammy AS backend-build
ARG APP_VERSION
WORKDIR /app
COPY .mvn/ .mvn/
COPY mvnw mvnw.cmd pom.xml ./
RUN chmod +x mvnw
RUN --mount=type=cache,target=/root/.m2/repository ./mvnw -B -DskipTests dependency:go-offline
COPY src/ src/
COPY --from=frontend-build /app/vue-code/../src/main/resources/static src/main/resources/static/
COPY vue-code/src/data/ vue-code/src/data/
RUN --mount=type=cache,target=/root/.m2/repository ./mvnw -B -Dmaven.test.skip=true -Drevision="${APP_VERSION}" package

FROM ${PLAYWRIGHT_BASE_IMAGE} AS playwright-browser

FROM eclipse-temurin:21-jre-jammy
ARG APP_VERSION
ARG RUNTIME_FINGERPRINT
ARG APP_UID=10001
ARG APP_GID=10001
LABEL org.opencontainers.image.title="XianYu2"
LABEL org.opencontainers.image.description="多租户闲鱼虚拟商品运营平台"
LABEL org.opencontainers.image.version="${APP_VERSION}"
LABEL org.opencontainers.image.licenses="MIT"
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates fonts-liberation fonts-noto-cjk jq libasound2 libatk-bridge2.0-0 libatk1.0-0 \
        libatspi2.0-0 libcairo2 libcups2 libdbus-1-3 libdrm2 libfontconfig1 \
        libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 \
        libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
        libxkbcommon0 libxrandr2 libxshmfence1 wget \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid "$APP_GID" xianyu2 && useradd --uid "$APP_UID" --gid xianyu2 --home-dir /app --no-create-home xianyu2 \
    && mkdir -p /app/data /app/logs /app/runtime /app/update /opt/xianyu2 \
    && chown -R xianyu2:xianyu2 /app /opt/xianyu2
COPY --from=backend-build --chown=xianyu2:xianyu2 /app/target/xianyu2-*.jar /opt/xianyu2/app.jar
COPY --from=playwright-browser --chown=xianyu2:xianyu2 /ms-playwright /app/ms-playwright
COPY --chown=xianyu2:xianyu2 docker/entrypoint.sh /usr/local/bin/xianyu2-entrypoint
RUN chmod 0755 /usr/local/bin/xianyu2-entrypoint
EXPOSE 12400
ENV JAVA_OPTS="-XX:MaxRAMPercentage=65 -XX:InitialRAMPercentage=20 -XX:+ExitOnOutOfMemoryError"
ENV SERVER_PORT=12400
ENV PLAYWRIGHT_BROWSERS_PATH=/app/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV RUNTIME_FINGERPRINT=${RUNTIME_FINGERPRINT}
USER xianyu2
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:12400/actuator/health || exit 1
ENTRYPOINT ["/usr/local/bin/xianyu2-entrypoint"]
