[Unit]
Description=XianYu2 release update agent
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/xianyu2/xianyu2-update-agent
Restart=on-failure
RestartSec=15s
# 必须大于 update-agent.conf 中的 TASK_TOTAL_TIMEOUT_SECONDS。
TimeoutStartSec=5h
TimeoutStopSec=30s
Nice=10
NoNewPrivileges=true
PrivateTmp=true
# Cosign caches trusted TUF/Rekor metadata below $HOME. Keep that cache in the
# root-only agent work area because ProtectHome and ProtectSystem stay enabled.
Environment=HOME=/var/lib/xianyu2/update/private/cosign
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xianyu2 /etc/xianyu2

[Install]
WantedBy=multi-user.target
