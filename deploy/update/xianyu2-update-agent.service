[Unit]
Description=XianYu2 release update agent
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=4

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/xianyu2/xianyu2-update-agent
Restart=on-failure
RestartSec=15s
# 必须大于 update-agent.conf 中的 TASK_TOTAL_TIMEOUT_SECONDS。
TimeoutStartSec=5h
TimeoutStopSec=30s
Nice=10
NoNewPrivileges=true
PrivateTmp=true
# Cosign caches trusted TUF/Rekor metadata below $HOME. Keep that cache in the
# root-only agent work area because ProtectHome and ProtectSystem stay enabled.
Environment=HOME=/var/lib/xianyu2/update/private/cosign
ProtectHome=true
ProtectSystem=strict
# 项目目录由安装器根据 root 所有的 update-agent.conf 写入对应 drop-in。
# 这些路径只对已验签 host package 的 root 代理可写，不会挂载到应用容器。
ReadWritePaths=/var/lib/xianyu2 /etc/xianyu2 /usr/local/lib/xianyu2 /etc/systemd/system

[Install]
WantedBy=multi-user.target
