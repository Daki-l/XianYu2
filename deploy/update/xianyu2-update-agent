require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    return 1
  }
}

assert_root_owned_protected_file() {
  local path="$1"
  local label="$2"
  (( EUID == 0 )) || return 0
  [[ -f "$path" && ! -L "$path" ]] || {
    echo "$label must be a regular file: $path" >&2
    return 1
  }
  [[ "$(stat -c '%u' "$path")" == 0 ]] || {
    echo "$label must be owned by root: $path" >&2
    return 1
  }
  local mode
  mode=$((8#$(stat -c '%a' "$path")))
  (( (mode & 8#22) == 0 )) || {
    echo "$label must not be group- or world-writable: $path" >&2
    return 1
  }
  assert_root_owned_protected_parent_directories "$path" "$label"
}

assert_root_owned_protected_directory() {
  local path="$1"
  local label="$2"
  (( EUID == 0 )) || return 0
  [[ -d "$path" && ! -L "$path" ]] || {
    echo "$label must be a real directory: $path" >&2
    return 1
  }
  [[ "$(stat -c '%u' "$path")" == 0 ]] || {
    echo "$label must be owned by root: $path" >&2
    return 1
  }
  local mode
  mode=$((8#$(stat -c '%a' "$path")))
  (( (mode & 8#22) == 0 )) || {
    echo "$label must not be group- or world-writable: $path" >&2
    return 1
  }
  assert_root_owned_protected_parent_directories "$path" "$label"
}

assert_root_owned_protected_parent_directories() {
  local path="$1"
  local label="$2"
  (( EUID == 0 )) || return 0
  local directory
  directory="$(dirname "$path")"
  while :; do
    [[ -d "$directory" && ! -L "$directory" ]] || {
      echo "$label parent directory must be a real directory: $directory" >&2
      return 1
    }
    [[ "$(stat -c '%u' "$directory")" == 0 ]] || {
      echo "$label parent directory must be owned by root: $directory" >&2
      return 1
    }
    local mode
    mode=$((8#$(stat -c '%a' "$directory")))
    (( (mode & 8#22) == 0 )) || {
      echo "$label parent directory must not be group- or world-writable: $directory" >&2
      return 1
    }
    [[ "$directory" == '/' ]] && break
    directory="$(dirname "$directory")"
  done
}

validate_update_http_proxy() {
  local proxy="$1"
  local authority port
  local authority_pattern='^([A-Za-z0-9._~!$&()*+,;=%-]+(:[A-Za-z0-9._~!$&()*+,;=%-]*)?@)?(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.-]+)(:[0-9]{1,5})?$'
  case "$proxy" in
    http://*|https://*) ;;
    *)
      echo 'UPDATE_HTTP_PROXY must use an http:// or https:// URL.' >&2
      return 1
      ;;
  esac
  authority="${proxy#*://}"
  authority="${authority%/}"
  [[ -n "$authority" && "$authority" != */* && "$authority" != *\?* && "$authority" != *\#* ]] \
    && [[ "$authority" =~ $authority_pattern ]] || {
      echo 'UPDATE_HTTP_PROXY must be an HTTP/HTTPS CONNECT proxy authority without a path, query, or fragment.' >&2
      return 1
    }
  if [[ "$authority" =~ :([0-9]+)$ ]]; then
    port="${BASH_REMATCH[1]}"
    (( 10#$port >= 1 && 10#$port <= 65535 )) || {
      echo 'UPDATE_HTTP_PROXY port must be between 1 and 65535.' >&2
      return 1
    }
  fi
}

validate_update_no_proxy() {
  local no_proxy="$1"
  [[ -z "$no_proxy" || "$no_proxy" =~ ^[A-Za-z0-9._:/-]+(,[A-Za-z0-9._:/-]+)*$ ]] || {
    echo 'UPDATE_NO_PROXY must be a comma-separated list of hosts, IP addresses, or CIDR ranges without whitespace.' >&2
    return 1
  }
}

# Only curl and Cosign need the optional update proxy. Keep the setting out of
# the Docker client and application process so it cannot alter container traffic.
run_with_update_proxy() {
  (
    unset ALL_PROXY HTTPS_PROXY HTTP_PROXY NO_PROXY all_proxy https_proxy http_proxy no_proxy
    if [[ -n "$UPDATE_HTTP_PROXY" ]]; then
      export HTTP_PROXY="$UPDATE_HTTP_PROXY"
      export HTTPS_PROXY="$UPDATE_HTTP_PROXY"
      export http_proxy="$UPDATE_HTTP_PROXY"
      export https_proxy="$UPDATE_HTTP_PROXY"
      export NO_PROXY="$UPDATE_NO_PROXY"
      export no_proxy="$UPDATE_NO_PROXY"
    fi
    "$@"
  )
}

run_update_curl() {
  run_with_update_proxy curl "$@"
}

run_update_cosign() {
  run_with_update_proxy run_with_timeout "$@"
}

# These helpers are only invoked as background jobs by transfer monitors. They
# replace that job with curl so a stall timeout can terminate the real network
# process instead of an intermediate shell.
start_update_curl() {
  unset ALL_PROXY HTTPS_PROXY HTTP_PROXY NO_PROXY all_proxy https_proxy http_proxy no_proxy
  if [[ -n "$UPDATE_HTTP_PROXY" ]]; then
    export HTTP_PROXY="$UPDATE_HTTP_PROXY"
    export HTTPS_PROXY="$UPDATE_HTTP_PROXY"
    export http_proxy="$UPDATE_HTTP_PROXY"
    export https_proxy="$UPDATE_HTTP_PROXY"
    export NO_PROXY="$UPDATE_NO_PROXY"
    export no_proxy="$UPDATE_NO_PROXY"
  fi
  exec curl "$@"
}

# Docker image pulls are performed by the Docker daemon, not through the
# release-download proxy. The Unix socket keeps the request local while the
# daemon continues to apply its own configured registry proxy.
start_docker_engine_curl() {
  unset ALL_PROXY HTTPS_PROXY HTTP_PROXY NO_PROXY all_proxy https_proxy http_proxy no_proxy
  exec curl --unix-socket "$DOCKER_ENGINE_SOCKET" "$@"
}

load_config() {
  [[ -r "$config_file" ]] || {
    echo "Update agent config is not readable: $config_file" >&2
    return 1
  }
  assert_root_owned_protected_file "$config_file" 'Update agent config'
  # 配置文件只由 root 安装流程写入，避免从应用可写目录加载命令或路径。
  # shellcheck disable=SC1090
  source "$config_file"
  : "${PROJECT_DIR:?PROJECT_DIR is required}"
  : "${COMPOSE_FILE:?COMPOSE_FILE is required}"
  : "${ENV_FILE:?ENV_FILE is required}"
  : "${RELEASE_ENV_FILE:?RELEASE_ENV_FILE is required}"
  : "${UPDATE_REQUEST_DIR:?UPDATE_REQUEST_DIR is required}"
  : "${UPDATE_STATUS_DIR:?UPDATE_STATUS_DIR is required}"
  : "${UPDATE_WORK_DIR:?UPDATE_WORK_DIR is required}"
  : "${RUNTIME_DIR:?RUNTIME_DIR is required}"
  : "${APP_UID:?APP_UID is required}"
  : "${APP_GID:?APP_GID is required}"
  : "${RELEASE_REPOSITORY:?RELEASE_REPOSITORY is required}"
  : "${COSIGN_OIDC_ISSUER:?COSIGN_OIDC_ISSUER is required}"
  BACKUP_HOOK="${BACKUP_HOOK:-}"
  HEALTH_TIMEOUT_SECONDS="${HEALTH_TIMEOUT_SECONDS:-240}"
  HEARTBEAT_INTERVAL_SECONDS="${HEARTBEAT_INTERVAL_SECONDS:-15}"
  TASK_RECOVERY_TIMEOUT_SECONDS="${TASK_RECOVERY_TIMEOUT_SECONDS:-300}"
  DOWNLOAD_TIMEOUT_SECONDS="${DOWNLOAD_TIMEOUT_SECONDS:-1800}"
  DOWNLOAD_MAX_TIMEOUT_SECONDS="${DOWNLOAD_MAX_TIMEOUT_SECONDS:-14400}"
  DOWNLOAD_IDLE_TIMEOUT_SECONDS="${DOWNLOAD_IDLE_TIMEOUT_SECONDS:-600}"
  BACKUP_TIMEOUT_SECONDS="${BACKUP_TIMEOUT_SECONDS:-900}"
  TASK_TOTAL_TIMEOUT_SECONDS="${TASK_TOTAL_TIMEOUT_SECONDS:-17100}"
  UPDATE_HTTP_PROXY="${UPDATE_HTTP_PROXY:-}"
  UPDATE_NO_PROXY="${UPDATE_NO_PROXY:-localhost,127.0.0.1,::1,mysql}"
  DOCKER_ENGINE_SOCKET="${DOCKER_ENGINE_SOCKET:-/var/run/docker.sock}"
  AUTO_APPLY_HOST_PACKAGE_UPDATES="${AUTO_APPLY_HOST_PACKAGE_UPDATES:-true}"
  [[ "$PROJECT_DIR" == /* && "$PROJECT_DIR" != '/' && "$PROJECT_DIR" != *$'\n'* ]] || {
    echo 'PROJECT_DIR must be an absolute non-root path.' >&2
    return 1
  }
  case "$AUTO_APPLY_HOST_PACKAGE_UPDATES" in
    true|false) ;;
    *)
      echo 'AUTO_APPLY_HOST_PACKAGE_UPDATES must be true or false.' >&2
      return 1
      ;;
  esac
  if [[ -n "$UPDATE_HTTP_PROXY" ]]; then
    validate_update_http_proxy "$UPDATE_HTTP_PROXY"
  fi
  validate_update_no_proxy "$UPDATE_NO_PROXY"
  [[ "$DOCKER_ENGINE_SOCKET" == /* && "$DOCKER_ENGINE_SOCKET" != *$'\n'* ]] || {
    echo 'DOCKER_ENGINE_SOCKET must be an absolute Unix socket path.' >&2
    return 1
  }
  for timeout in "$HEALTH_TIMEOUT_SECONDS" "$HEARTBEAT_INTERVAL_SECONDS" "$TASK_RECOVERY_TIMEOUT_SECONDS" "$DOWNLOAD_TIMEOUT_SECONDS" "$DOWNLOAD_MAX_TIMEOUT_SECONDS" "$DOWNLOAD_IDLE_TIMEOUT_SECONDS" "$BACKUP_TIMEOUT_SECONDS" "$TASK_TOTAL_TIMEOUT_SECONDS"; do
    [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || {
      echo 'Update agent timeout values must be positive integers.' >&2
      return 1
    }
  done
  (( DOWNLOAD_IDLE_TIMEOUT_SECONDS < DOWNLOAD_MAX_TIMEOUT_SECONDS )) || {
    echo 'DOWNLOAD_IDLE_TIMEOUT_SECONDS must be lower than DOWNLOAD_MAX_TIMEOUT_SECONDS.' >&2
    return 1
  }
  (( DOWNLOAD_TIMEOUT_SECONDS <= DOWNLOAD_MAX_TIMEOUT_SECONDS )) || {
    echo 'DOWNLOAD_TIMEOUT_SECONDS must not exceed DOWNLOAD_MAX_TIMEOUT_SECONDS.' >&2
    return 1
  }
  (( TASK_TOTAL_TIMEOUT_SECONDS + 30 <= systemd_timeout_seconds )) || {
    echo 'TASK_TOTAL_TIMEOUT_SECONDS must leave at least 30 seconds before the packaged systemd timeout.' >&2
    return 1
  }
  assert_root_owned_protected_directory "$PROJECT_DIR" 'Project directory'
  assert_root_owned_protected_file "$COMPOSE_FILE" 'Compose file'
  assert_root_owned_protected_file "$ENV_FILE" 'Environment file'
  if [[ -e "$RELEASE_ENV_FILE" ]]; then
    assert_root_owned_protected_file "$RELEASE_ENV_FILE" 'Release environment file'
  else
    assert_root_owned_protected_parent_directories "$RELEASE_ENV_FILE" 'Release environment file'
  fi
  if [[ -n "$BACKUP_HOOK" ]]; then
    assert_root_owned_protected_file "$BACKUP_HOOK" 'Backup hook'
  fi
}

preflight() {
  require_command curl
  require_command jq
  require_command cosign
  require_command docker
  require_command flock
  require_command sha256sum
  require_command stat
  require_command timeout
  require_command mkfifo
  require_command tar
  require_command find
  assert_root_owned_protected_file "$agent_version_file" 'Update agent version file'
  case "$(uname -m)" in
    x86_64|amd64) ;;
    *) echo "Unsupported host architecture: $(uname -m); only linux/amd64 is supported." >&2; return 1 ;;
  esac
  [[ -f "$COMPOSE_FILE" ]] || { echo "Compose file not found: $COMPOSE_FILE" >&2; return 1; }
  [[ -f "$ENV_FILE" ]] || { echo "Environment file not found: $ENV_FILE" >&2; return 1; }
  [[ "$APP_UID" =~ ^[0-9]+$ && "$APP_GID" =~ ^[0-9]+$ ]] || {
    echo 'APP_UID and APP_GID must be numeric.' >&2
    return 1
  }
  if (( EUID == 0 )); then
    install -d -m 0750 -o "$APP_UID" -g "$APP_GID" "$UPDATE_REQUEST_DIR"
    install -d -m 0755 -o root -g root "$UPDATE_STATUS_DIR" "$RUNTIME_DIR"
    install -d -m 0750 -o root -g root "$UPDATE_WORK_DIR" "$UPDATE_WORK_DIR/in-progress" "$UPDATE_WORK_DIR/archive" "$UPDATE_WORK_DIR/cache" "$RUNTIME_DIR/archive"
  else
    # 单元测试以非 root 身份运行；正式安装器和 systemd unit 均强制 root。
    install -d -m 0750 "$UPDATE_REQUEST_DIR" "$UPDATE_WORK_DIR" "$UPDATE_WORK_DIR/in-progress" "$UPDATE_WORK_DIR/archive" "$UPDATE_WORK_DIR/cache" "$RUNTIME_DIR/archive"
    install -d -m 0755 "$UPDATE_STATUS_DIR" "$RUNTIME_DIR"
  fi
  [[ "$(stat -c '%d' "$UPDATE_REQUEST_DIR")" == "$(stat -c '%d' "$UPDATE_WORK_DIR")" ]] || {
    echo 'UPDATE_REQUEST_DIR and UPDATE_WORK_DIR must be on the same filesystem.' >&2
    return 1
  }
  touch "$UPDATE_STATUS_DIR/agent.ready"
  chmod 0644 "$UPDATE_STATUS_DIR/agent.ready"
}

timestamp() {
  date --iso-8601=seconds
}

run_with_timeout() {
  local seconds="$1"
  shift
  seconds="$(remaining_timeout_seconds "$seconds")"
  timeout --foreground "${seconds}s" "$@"
}

remaining_timeout_seconds() {
  local requested="$1"
  if (( task_deadline_epoch == 0 )); then
    printf '%s\n' "$requested"
    return 0
  fi
  local remaining=$((task_deadline_epoch - $(date +%s)))
  (( remaining > 0 )) || {
    echo 'The update task total timeout has elapsed.' >&2
    return 124
  }
  if (( remaining < requested )); then
    printf '%s\n' "$remaining"
  else
    printf '%s\n' "$requested"
  fi
}

stop_task_timeout() {
  [[ -n "$task_timeout_pid" ]] || return 0
  if kill -0 "$task_timeout_pid" 2>/dev/null; then
    kill "$task_timeout_pid" 2>/dev/null || true
  fi
  wait "$task_timeout_pid" 2>/dev/null || true
  task_timeout_pid=''
}

start_task_timeout() {
  local now task_started_epoch remaining
  task_started_at="${task_started_at:-$(timestamp)}"
  now="$(date +%s)"
  task_started_epoch="$(date --date="$task_started_at" +%s 2>/dev/null || true)"
  if [[ "$task_started_epoch" =~ ^[0-9]+$ && "$task_started_epoch" -le "$now" ]]; then
    remaining=$((TASK_TOTAL_TIMEOUT_SECONDS - (now - task_started_epoch)))
  else
    # A malformed persisted timestamp must not silently grant an unbounded
    # second task lifetime after a self-update hand-off.
    task_started_at="$(timestamp)"
    remaining="$TASK_TOTAL_TIMEOUT_SECONDS"
  fi
  (( remaining > 0 )) || {
    echo 'The update task total timeout has elapsed.' >&2
    return 124
  }
  task_deadline_epoch=$((now + remaining))
  (
    # 不让后台 sleep 继承任务锁；代理退出后必须立即允许后续请求重新竞争锁。
    exec 9>&-
    sleep "$remaining"
    kill -TERM "$$" 2>/dev/null || true
  ) &
  task_timeout_pid=$!
}

write_json_atomically() {
  local target="$1"
  local contents="$2"
  local temporary="${target}.tmp.$$"
  printf '%s\n' "$contents" > "$temporary"
  mv -f "$temporary" "$target"
}

is_terminal_status() {
  [[ "$1" == 'SUCCESS' || "$1" == 'FAILED' || "$1" == 'MANUAL_REQUIRED' ]]
}

is_release_version() {
  [[ "$1" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]
}

is_older_release_version() {
  local candidate="$1"
  local current="$2"
  local candidate_major candidate_minor candidate_patch current_major current_minor current_patch
  IFS=. read -r candidate_major candidate_minor candidate_patch <<< "$candidate"
  IFS=. read -r current_major current_minor current_patch <<< "$current"
  for component in major minor patch; do
    local candidate_value="candidate_${component}"
    local current_value="current_${component}"
    if (( 10#${!candidate_value} < 10#${!current_value} )); then
      return 0
    fi
    if (( 10#${!candidate_value} > 10#${!current_value} )); then
      return 1
    fi
  done
  return 1
}

stage_timeout_seconds() {
  case "$1" in
    DOWNLOADING) printf '%s\n' "$DOWNLOAD_MAX_TIMEOUT_SECONDS" ;;
    VERIFYING|CHECKING) printf '%s\n' "$DOWNLOAD_TIMEOUT_SECONDS" ;;
    BACKING_UP) printf '%s\n' "$BACKUP_TIMEOUT_SECONDS" ;;
    RESTARTING|HEALTH_CHECKING) printf '%s\n' "$HEALTH_TIMEOUT_SECONDS" ;;
    *) printf '%s\n' "$TASK_RECOVERY_TIMEOUT_SECONDS" ;;
  esac
}

reset_transfer_state() {
  transfer_phase=''
  transfer_downloaded_bytes=0
  transfer_total_bytes=0
  transfer_speed_bytes_per_second=0
  transfer_eta_seconds=''
  transfer_current_layer=''
  transfer_completed_layers=0
  transfer_total_layers=0
  transfer_last_sample_millis=0
  transfer_last_sample_bytes=0
  transfer_last_progress_epoch=0
  transfer_started_epoch=0
  transfer_deadline_epoch=0
  transfer_max_deadline_epoch=0
}

begin_transfer() {
  local phase="$1"
  local total_bytes="$2"
  local progress="$3"
  local message="$4"
  local detail="${5:-}"
  [[ "$phase" == 'JAR_DOWNLOAD' || "$phase" == 'HOST_PACKAGE_DOWNLOAD' || "$phase" == 'IMAGE_PULL' ]] || {
    echo "Unsupported transfer phase: $phase" >&2
    return 1
  }
  [[ "$total_bytes" =~ ^[0-9]+$ ]] || {
    echo 'Transfer total bytes must be a non-negative integer.' >&2
    return 1
  }
  stop_heartbeat
  reset_transfer_state
  transfer_phase="$phase"
  transfer_total_bytes="$total_bytes"
  transfer_started_epoch="$(date +%s)"
  transfer_last_sample_millis="$(date +%s%3N)"
  transfer_last_progress_epoch="$transfer_started_epoch"
  transfer_max_deadline_epoch=$((transfer_started_epoch + DOWNLOAD_MAX_TIMEOUT_SECONDS))
  if (( task_deadline_epoch > 0 && task_deadline_epoch < transfer_max_deadline_epoch )); then
    transfer_max_deadline_epoch="$task_deadline_epoch"
  fi
  transfer_deadline_epoch=$((transfer_started_epoch + DOWNLOAD_TIMEOUT_SECONDS))
  if (( transfer_deadline_epoch > transfer_max_deadline_epoch )); then
    transfer_deadline_epoch="$transfer_max_deadline_epoch"
  fi
  AGENT_HEARTBEAT_WRITER=true write_status DOWNLOADING "$progress" "$message" "$detail"
}

extend_transfer_deadline() {
  local now="$1"
  local extension="$DOWNLOAD_TIMEOUT_SECONDS"
  local eta eta_for_extension candidate_deadline
  if (( transfer_total_bytes > transfer_downloaded_bytes && transfer_speed_bytes_per_second > 0 )); then
    eta=$(((transfer_total_bytes - transfer_downloaded_bytes + transfer_speed_bytes_per_second - 1) / transfer_speed_bytes_per_second))
    # A slow proxy should receive enough time for the observed remaining work,
    # but never turn one transfer into an unbounded task.
    eta_for_extension="$eta"
    (( eta_for_extension > DOWNLOAD_MAX_TIMEOUT_SECONDS )) && eta_for_extension="$DOWNLOAD_MAX_TIMEOUT_SECONDS"
    extension=$((eta_for_extension + DOWNLOAD_IDLE_TIMEOUT_SECONDS))
    (( extension < DOWNLOAD_TIMEOUT_SECONDS )) && extension="$DOWNLOAD_TIMEOUT_SECONDS"
  fi
  candidate_deadline=$((now + extension))
  (( candidate_deadline > transfer_max_deadline_epoch )) && candidate_deadline="$transfer_max_deadline_epoch"
  (( candidate_deadline > transfer_deadline_epoch )) && transfer_deadline_epoch="$candidate_deadline"
}

update_transfer_state() {
  local downloaded="$1"
  local total="$2"
  local current_layer="${3:-}"
  local completed_layers="${4:-0}"
  local total_layers="${5:-0}"
  [[ "$downloaded" =~ ^[0-9]+$ && "$total" =~ ^[0-9]+$ ]] || {
    echo 'Transfer byte counters must be non-negative integers.' >&2
    return 1
  }
  [[ "$completed_layers" =~ ^[0-9]+$ && "$total_layers" =~ ^[0-9]+$ ]] || {
    echo 'Transfer layer counters must be non-negative integers.' >&2
    return 1
  }
  (( total == 0 || downloaded <= total )) || downloaded="$total"
  (( total_layers == 0 || completed_layers <= total_layers )) || completed_layers="$total_layers"

  local now now_millis elapsed_millis delta speed=0 byte_progressed=false
  now="$(date +%s)"
  now_millis="$(date +%s%3N)"
  elapsed_millis=$((now_millis - transfer_last_sample_millis))
  if (( elapsed_millis > 0 )); then
    delta=$((downloaded - transfer_last_sample_bytes))
    if (( delta > 0 )); then
      # Use the real sub-second sampling interval so a small first chunk does
      # not report a zero speed merely because it arrived within one second.
      speed=$(((delta * 1000 + elapsed_millis - 1) / elapsed_millis))
      if (( transfer_speed_bytes_per_second > 0 && speed > 0 )); then
        transfer_speed_bytes_per_second=$(((transfer_speed_bytes_per_second * 3 + speed) / 4))
      elif (( speed > 0 )); then
        transfer_speed_bytes_per_second="$speed"
      fi
      transfer_last_progress_epoch="$now"
      byte_progressed=true
    elif (( now - transfer_last_progress_epoch >= 5 )); then
      transfer_speed_bytes_per_second=0
    fi
    transfer_last_sample_millis="$now_millis"
    transfer_last_sample_bytes="$downloaded"
  fi

  transfer_downloaded_bytes="$downloaded"
  transfer_total_bytes="$total"
  transfer_current_layer="$current_layer"
  transfer_completed_layers="$completed_layers"
  transfer_total_layers="$total_layers"
  if (( total > downloaded && transfer_speed_bytes_per_second > 0 )); then
    transfer_eta_seconds=$(((total - downloaded + transfer_speed_bytes_per_second - 1) / transfer_speed_bytes_per_second))
  else
    transfer_eta_seconds=''
  fi
  if [[ "$byte_progressed" == 'true' ]]; then
    extend_transfer_deadline "$now"
  fi
}

publish_transfer_status() {
  local progress="$1"
  local message="$2"
  local detail="${3:-}"
  AGENT_HEARTBEAT_WRITER=true write_status DOWNLOADING "$progress" "$message" "$detail"
}

finish_transfer() {
  downloaded_bytes="$transfer_downloaded_bytes"
  total_bytes="$transfer_total_bytes"
  reset_transfer_state
}

stop_heartbeat() {
  [[ -n "$heartbeat_pid" ]] || return 0
  if kill -0 "$heartbeat_pid" 2>/dev/null; then
    kill "$heartbeat_pid" 2>/dev/null || true
  fi
  wait "$heartbeat_pid" 2>/dev/null || true
  heartbeat_pid=''
  heartbeat_status=''
}

start_heartbeat() {
  local status="$1"
  local progress="$2"
  local message="$3"
  local detail="$4"
  if is_terminal_status "$status"; then
    stop_heartbeat
    return 0
  fi
  if [[ "$heartbeat_status" == "$status" && -n "$heartbeat_pid" ]] && kill -0 "$heartbeat_pid" 2>/dev/null; then
    return 0
  fi
  stop_heartbeat
  (
    # 心跳进程只写状态，不能延长 flock 的生命周期。
    exec 9>&-
    while sleep "$HEARTBEAT_INTERVAL_SECONDS"; do
      AGENT_HEARTBEAT_WRITER=true write_status "$status" "$progress" "$message" "$detail" || true
    done
  ) &
  heartbeat_pid=$!
  heartbeat_status="$status"
}

write_status() {
  local status="$1"
  local progress="$2"
  local message="$3"
  local detail="${4:-}"
  local payload status_downloaded_bytes status_total_bytes status_timeout_seconds now
  status_downloaded_bytes="$downloaded_bytes"
  status_total_bytes="$total_bytes"
  if [[ -n "$transfer_phase" ]]; then
    status_downloaded_bytes="$transfer_downloaded_bytes"
    status_total_bytes="$transfer_total_bytes"
  fi
  status_timeout_seconds="$(stage_timeout_seconds "$status")"
  if [[ "$status" == 'DOWNLOADING' && -n "$transfer_phase" && "$transfer_deadline_epoch" =~ ^[1-9][0-9]*$ ]]; then
    now="$(date +%s)"
    status_timeout_seconds=$((transfer_deadline_epoch - now))
    (( status_timeout_seconds > 0 )) || status_timeout_seconds=1
  fi
  if [[ -z "$stage_started_at" || "$current_stage" != "$status" ]]; then
    current_stage="$status"
    stage_started_at="$(timestamp)"
  fi
  payload="$(jq -n \
    --argjson schemaVersion 1 \
    --arg taskId "$task_id" \
    --arg version "$task_version" \
    --arg status "$status" \
    --arg message "$message" \
    --arg detail "$detail" \
    --arg taskStartedAt "$task_started_at" \
    --arg stageStartedAt "$stage_started_at" \
    --arg updatedAt "$(timestamp)" \
    --argjson timeoutSeconds "$status_timeout_seconds" \
    --argjson progress "$progress" \
    --argjson downloadedBytes "$status_downloaded_bytes" \
    --argjson totalBytes "$status_total_bytes" \
    --arg transferPhase "$transfer_phase" \
    --argjson transferDownloadedBytes "$transfer_downloaded_bytes" \
    --argjson transferTotalBytes "$transfer_total_bytes" \
    --argjson transferSpeedBytesPerSecond "$transfer_speed_bytes_per_second" \
    --arg transferEtaSeconds "$transfer_eta_seconds" \
    --arg transferCurrentLayer "$transfer_current_layer" \
    --argjson transferCompletedLayers "$transfer_completed_layers" \
    --argjson transferTotalLayers "$transfer_total_layers" \
    --arg backupPath "$backup_path" \
    --arg backupSha256 "$backup_sha256" \
    '{schemaVersion: $schemaVersion, taskId: $taskId, version: $version, status: $status, progress: $progress,
       message: $message, detail: $detail, taskStartedAt: $taskStartedAt, stageStartedAt: $stageStartedAt,
      updatedAt: $updatedAt, timeoutSeconds: $timeoutSeconds,
       downloadedBytes: $downloadedBytes, totalBytes: $totalBytes}
      + (if $transferPhase == "" then {} else {transfer: {
          phase: $transferPhase, downloadedBytes: $transferDownloadedBytes, totalBytes: $transferTotalBytes,
          speedBytesPerSecond: $transferSpeedBytesPerSecond,
          etaSeconds: (if $transferEtaSeconds == "" then null else ($transferEtaSeconds | tonumber) end),
          currentLayer: (if $transferCurrentLayer == "" then null else $transferCurrentLayer end),
          completedLayers: $transferCompletedLayers, totalLayers: $transferTotalLayers
        }} end)
      + (if $backupPath == "" then {} else {backup: {path: $backupPath, sha256: $backupSha256}} end)')"
  write_json_atomically "$UPDATE_STATUS_DIR/status.json" "$payload"
  if [[ "${AGENT_HEARTBEAT_WRITER:-false}" != 'true' ]]; then
    start_heartbeat "$status" "$progress" "$message" "$detail"
  fi
}

archive_task() {
  [[ -n "$task_file" && -f "$task_file" ]] || return 0
  mv -f "$task_file" "$UPDATE_WORK_DIR/archive/${task_id}-$(date +%s).json"
  task_file=''
}

fail_task() {
  local message="$1"
  local detail="${2:-查看宿主机 xianyu2-update-agent 日志和更新目录中的归档文件。}"
  [[ -z "$transfer_phase" ]] || finish_transfer
  write_status FAILED 100 "$message" "$detail" || true
  archive_task || true
}

on_error() {
  local exit_code=$?
  if [[ -n "$task_id" ]]; then
    if [[ "$transfer_cancelled" == 'true' ]]; then
      fail_task '更新已取消' "$transfer_failure_detail"
    elif [[ "$app_recreate_started" == 'true' ]]; then
      fail_task "更新失败（退出码 ${exit_code}）" \
        '已尝试启动新应用容器，Flyway 可能已执行。请勿假定已自动回退；请按备份、容器日志和归档文件人工恢复。'
    else
      fail_task "更新失败（退出码 ${exit_code}）" \
        "${transfer_failure_detail:-查看宿主机 xianyu2-update-agent 日志和更新目录中的归档文件。}"
    fi
  fi
  exit "$exit_code"
}

trap on_error ERR

on_terminate() {
  if [[ -n "$task_id" ]]; then
    if [[ "$app_recreate_started" == 'true' ]]; then
      fail_task '更新任务超过总时限，未继续执行' \
        '已尝试启动新应用容器，Flyway 可能已执行。请勿假定已自动回退；请按备份、容器日志和归档文件人工恢复。'
    else
      fail_task '更新任务超过总时限，未继续执行'
    fi
  fi
  exit 124
}

trap on_terminate TERM

cleanup_download_dir() {
  [[ -n "$download_dir" && -d "$download_dir" ]] || return 0
  rm -rf "$download_dir"
}

stop_active_transfer() {
  if [[ -n "$active_transfer_pid" ]] && kill -0 "$active_transfer_pid" 2>/dev/null; then
    kill -TERM "$active_transfer_pid" 2>/dev/null || true
  fi
  if [[ -n "$active_transfer_parser_pid" ]] && kill -0 "$active_transfer_parser_pid" 2>/dev/null; then
    kill -TERM "$active_transfer_parser_pid" 2>/dev/null || true
  fi
  [[ -n "$active_transfer_pid" ]] && wait "$active_transfer_pid" 2>/dev/null || true
  [[ -n "$active_transfer_parser_pid" ]] && wait "$active_transfer_parser_pid" 2>/dev/null || true
  active_transfer_pid=''
  active_transfer_parser_pid=''
  [[ -n "$active_transfer_fifo" ]] && rm -f "$active_transfer_fifo"
  active_transfer_fifo=''
}

cleanup() {
  stop_active_transfer
  stop_heartbeat
  stop_task_timeout
  cleanup_download_dir
}

trap cleanup EXIT

claim_request() {
  local request="$UPDATE_REQUEST_DIR/request.json"
  local claimed="$UPDATE_WORK_DIR/in-progress/.request-claim-$$-${RANDOM}.json"
  if [[ ! -e "$request" && ! -L "$request" ]]; then
    return 1
  fi
  # 先以 rename 将应用可写目录中的对象移入私有目录，再验证。不能在
  # request 目录里检查后直接解析，否则应用进程可在两步之间替换文件。
  mv --no-target-directory -- "$request" "$claimed" || return 1
  if ! is_safe_request_file "$claimed"; then
    archive_invalid_request "$claimed"
    echo 'Refusing an unsafe update request file.' >&2
    return 1
  fi
  local candidate_id
  local schema_version
  if ! schema_version="$(jq -r '.schemaVersion // empty' "$claimed")"; then
    archive_invalid_request "$claimed"
    echo 'Refusing an invalid update request JSON document.' >&2
    return 1
  fi
  [[ "$schema_version" == '1' ]] || {
    archive_invalid_request "$claimed"
    return 1
  }
  if ! candidate_id="$(jq -r '.taskId // empty' "$claimed")"; then
    archive_invalid_request "$claimed"
    echo 'Refusing an invalid update request JSON document.' >&2
    return 1
  fi
  [[ "$candidate_id" =~ ^[0-9a-fA-F-]{36}$ ]] || {
    archive_invalid_request "$claimed"
    return 1
  }
  local final_claimed="$UPDATE_WORK_DIR/in-progress/${candidate_id}.json"
  if [[ -e "$final_claimed" || -L "$final_claimed" ]]; then
    archive_invalid_request "$claimed"
    echo 'Refusing a duplicate update task identifier.' >&2
    return 1
  fi
  task_id="$candidate_id"
  if ! task_version="$(jq -r '.version // empty' "$claimed")"; then
    archive_invalid_request "$claimed"
    echo 'Refusing an invalid update request JSON document.' >&2
    return 1
  fi
  task_started_at="$(timestamp)"
  task_file="$claimed"
  # 在移走应用可见的 request 前先写代理拥有的活跃状态，避免重复点击产生排队请求。
  write_status REQUESTED 1 '更新任务已由代理认领'
  mv --no-target-directory -- "$claimed" "$final_claimed"
  task_file="$final_claimed"
  return 0
}

is_safe_request_file() {
  local request="$1"
  [[ -f "$request" && ! -L "$request" ]] || return 1
  [[ "$(stat -c '%u' "$request")" == "$APP_UID" ]] || return 1
  [[ "$(stat -c '%g' "$request")" == "$APP_GID" ]] || return 1
  [[ "$(stat -c '%h' "$request")" == '1' ]] || return 1
  # request.json is created atomically by the application with owner read/write and
  # group read only. Anything else is an application-writable protocol violation.
  [[ "$(stat -c '%a' "$request")" == '640' ]]
}

archive_invalid_request() {
  local request="$1"
  [[ -e "$request" || -L "$request" ]] || return 0
  mv --no-target-directory -- "$request" \
    "$UPDATE_WORK_DIR/archive/invalid-request-$(date +%s)-$$-${RANDOM}.json"
}

claim_cancellation_request() {
  local cancellation="$UPDATE_REQUEST_DIR/cancel.json"
  local claimed="$UPDATE_WORK_DIR/in-progress/.cancel-claim-$$-${RANDOM}.json"
  if [[ ! -e "$cancellation" && ! -L "$cancellation" ]]; then
    return 1
  fi
  # Move the application-owned file into the private directory before reading
  # it, just like request.json, so the task id cannot change during validation.
  mv --no-target-directory -- "$cancellation" "$claimed" || return 1
  if ! is_safe_request_file "$claimed"; then
    archive_invalid_request "$claimed"
    echo 'Ignoring an unsafe update cancellation request.' >&2
    return 1
  fi
  local schema_version candidate_id requested_at
  schema_version="$(jq -r '.schemaVersion // empty' "$claimed" 2>/dev/null || true)"
  candidate_id="$(jq -r '.taskId // empty' "$claimed" 2>/dev/null || true)"
  requested_at="$(jq -r '.requestedAt // empty' "$claimed" 2>/dev/null || true)"
  if [[ "$schema_version" != '1' || ! "$candidate_id" =~ ^[0-9a-fA-F-]{36}$ || -z "$requested_at" || "$candidate_id" != "$task_id" ]]; then
    archive_invalid_request "$claimed"
    echo 'Ignoring an invalid or stale update cancellation request.' >&2
    return 1
  fi
  mv -f "$claimed" "$UPDATE_WORK_DIR/archive/cancel-${task_id}-$(date +%s)-$$-${RANDOM}.json"
}

consume_cancellation_request() {
  claim_cancellation_request || return 1
  transfer_cancelled=true
  transfer_failure_detail='更新已取消；候选文件或镜像尚未切换，可重新尝试。'
}

recover_unfinished_task() {
  local unfinished
  unfinished="$(find "$UPDATE_WORK_DIR/in-progress" -maxdepth 1 -type f -name '*.json' -print -quit 2>/dev/null || true)"
  [[ -n "$unfinished" ]] || return 0
  task_file="$unfinished"
  task_id="$(jq -r '.taskId // "unknown"' "$task_file")"
  task_version="$(jq -r '.version // ""' "$task_file")"
  local previous_status previous_task_id previous_task_started_at previous_status_value previous_transfer_phase last_heartbeat timeout_seconds heartbeat_epoch task_started_epoch now age remaining
  previous_status="$UPDATE_STATUS_DIR/status.json"
  previous_task_id="$(jq -r '.taskId // empty' "$previous_status" 2>/dev/null || true)"
  previous_task_started_at="$(jq -r '.taskStartedAt // empty' "$previous_status" 2>/dev/null || true)"
  previous_status_value="$(jq -r '.status // empty' "$previous_status" 2>/dev/null || true)"
  previous_transfer_phase="$(jq -r '.transfer.phase // empty' "$previous_status" 2>/dev/null || true)"
  last_heartbeat="$(jq -r '.updatedAt // empty' "$previous_status" 2>/dev/null || true)"
  timeout_seconds="$(jq -r '.timeoutSeconds // empty' "$previous_status" 2>/dev/null || true)"
  task_started_at=''
  heartbeat_epoch=''
  task_started_epoch=''
  if [[ "$previous_task_id" == "$task_id" && "$timeout_seconds" =~ ^[1-9][0-9]*$ && -n "$last_heartbeat" ]]; then
    heartbeat_epoch="$(date --date="$last_heartbeat" +%s 2>/dev/null || true)"
  fi
  if [[ -n "$previous_task_started_at" ]]; then
    task_started_epoch="$(date --date="$previous_task_started_at" +%s 2>/dev/null || true)"
    if [[ "$task_started_epoch" =~ ^[0-9]+$ ]]; then
      task_started_at="$previous_task_started_at"
    fi
  fi
  [[ -n "$task_started_at" ]] || task_started_at="$(timestamp)"
  now="$(date +%s)"
  if [[ "$task_started_epoch" =~ ^[0-9]+$ ]] && (( now - task_started_epoch >= TASK_TOTAL_TIMEOUT_SECONDS )); then
    write_status FAILED 100 '检测到超过总时限的更新任务，未自动重试' \
      '代理重启后保留原运行版本，请确认日志后重新提交更新。'
    archive_task
    return 0
  fi
  if [[ "$heartbeat_epoch" =~ ^[0-9]+$ ]]; then
    age=$((now - heartbeat_epoch))
    (( age < 0 )) && age=0
    if (( age <= timeout_seconds )); then
      remaining=$((timeout_seconds - age + 1))
      if [[ "$task_started_epoch" =~ ^[0-9]+$ ]]; then
        local total_remaining=$((TASK_TOTAL_TIMEOUT_SECONDS - (now - task_started_epoch) + 1))
        (( total_remaining < remaining )) && remaining="$total_remaining"
      fi
      if [[ "$previous_status_value" == 'DOWNLOADING' \
        && ( "$previous_transfer_phase" == 'JAR_DOWNLOAD' \
          || "$previous_transfer_phase" == 'HOST_PACKAGE_DOWNLOAD' \
          || "$previous_transfer_phase" == 'IMAGE_PULL' ) ]]; then
        # A service restart cannot resume the old curl/Docker Engine stream.
        # Keep only the no-byte-progress window before making it retryable.
        local transfer_recovery_remaining=$((DOWNLOAD_IDLE_TIMEOUT_SECONDS + 1))
        (( transfer_recovery_remaining < remaining )) && remaining="$transfer_recovery_remaining"
      fi
      (( remaining > 0 )) || remaining=1
      # After a host restart no process owns this task any more, but a heartbeat may
      # still be inside its declared phase window. Keep its durable state until that
      # deadline instead of exhausting systemd's restart limit in a tight loop.
      echo "A previous update task still has a valid heartbeat; waiting ${remaining} seconds for its phase timeout." >&2
      sleep "$remaining"
    fi
  fi
  write_status FAILED 100 "检测到超时或无心跳的更新任务，未自动重试" "代理重启后保留原运行版本，请确认日志后重新提交更新。"
  archive_task
}

release_api_for_tag() {
  local release_tag="$1"
  printf 'https://api.github.com/repos/Daki-l/XianYu2/releases/tags/%s\n' "$release_tag"
}

github_api_get() {
  local url="$1"
  local destination="$2"
  local timeout_seconds
  timeout_seconds="$(remaining_timeout_seconds "$DOWNLOAD_TIMEOUT_SECONDS")"
  run_update_curl --fail --silent --show-error --proto '=https' --max-redirs 0 --connect-timeout 15 --max-time "$timeout_seconds" \
    --header 'Accept: application/vnd.github+json' --header 'User-Agent: XianYu2-update-agent' \
    -o "$destination" "$url"
}

verify_release_commit() {
  local release_tag="$1"
  local expected_commit="$2"
  local ref_json="$download_dir/tag-ref.json"
  github_api_get "https://api.github.com/repos/Daki-l/XianYu2/git/ref/tags/${release_tag}" "$ref_json"

  local object_type object_sha actual_commit
  object_type="$(jq -er '.object.type' "$ref_json")"
  object_sha="$(jq -er '.object.sha' "$ref_json")"
  case "$object_type" in
    commit)
      actual_commit="$object_sha"
      ;;
    tag)
      local tag_json="$download_dir/annotated-tag.json"
      github_api_get "https://api.github.com/repos/Daki-l/XianYu2/git/tags/${object_sha}" "$tag_json"
      [[ "$(jq -er '.object.type' "$tag_json")" == 'commit' ]] || {
        echo 'Annotated release tag does not point to a commit.' >&2
        return 1
      }
      actual_commit="$(jq -er '.object.sha' "$tag_json")"
      ;;
    *)
      echo "Unsupported release tag object type: $object_type" >&2
      return 1
      ;;
  esac
  [[ "$actual_commit" == "$expected_commit" ]] || {
    echo 'Release tag commit does not match the signed manifest.' >&2
    return 1
  }
}

wait_for_file_transfer() {
  local pid="$1"
  local file="$2"
  local progress="$3"
  local message="$4"
  local detail="$5"
  local now bytes exit_code abort_reason=''

  while kill -0 "$pid" 2>/dev/null; do
    if consume_cancellation_request; then
      abort_reason="$transfer_failure_detail"
    fi
    bytes=0
    if [[ -f "$file" ]]; then
      bytes="$(stat -c '%s' "$file")"
    fi
    update_transfer_state "$bytes" "$transfer_total_bytes"
    publish_transfer_status "$progress" "$message" "$detail"
    now="$(date +%s)"
    if [[ -n "$abort_reason" ]]; then
      :
    elif (( now >= transfer_deadline_epoch )); then
      abort_reason="下载超过最长允许时长 ${DOWNLOAD_MAX_TIMEOUT_SECONDS} 秒，已停止。"
    elif (( now - transfer_last_progress_epoch >= DOWNLOAD_IDLE_TIMEOUT_SECONDS )); then
      abort_reason="下载连续 ${DOWNLOAD_IDLE_TIMEOUT_SECONDS} 秒无字节增长，已停止。"
    fi
    if [[ -n "$abort_reason" ]]; then
      transfer_failure_detail="$abort_reason"
      kill -TERM "$pid" 2>/dev/null || true
      break
    fi
    sleep 1
  done

  bytes=0
  if [[ -f "$file" ]]; then
    bytes="$(stat -c '%s' "$file")"
  fi
  update_transfer_state "$bytes" "$transfer_total_bytes"
  publish_transfer_status "$progress" "$message" "$detail"
  if wait "$pid"; then
    active_transfer_pid=''
    [[ -z "$abort_reason" ]] || return 124
    return 0
  fi
  exit_code=$?
  active_transfer_pid=''
  [[ -n "$abort_reason" ]] && return 124
  return "$exit_code"
}

download_api_asset() {
  local asset_id="$1"
  local destination="$2"
  local transfer_phase="${3:-}"
  local transfer_total="${4:-0}"
  local transfer_progress="${5:-20}"
  local transfer_message="${6:-正在下载发行文件}"
  local transfer_detail="${7:-}"
  [[ "$asset_id" =~ ^[1-9][0-9]*$ ]] || {
    echo "Invalid release asset id: $asset_id" >&2
    return 1
  }
  [[ -z "$transfer_phase" || "$transfer_phase" == 'JAR_DOWNLOAD' || "$transfer_phase" == 'HOST_PACKAGE_DOWNLOAD' ]] || {
    echo "Unsupported release asset transfer phase: $transfer_phase" >&2
    return 1
  }
  [[ "$transfer_total" =~ ^[0-9]+$ ]] || {
    echo 'Release asset transfer total must be a non-negative integer.' >&2
    return 1
  }

  # curl --location would contact each redirect target before we could inspect
  # it. Resolve each hop ourselves so an untrusted Release redirect never gets
  # a request from the privileged host agent.
  local url="https://api.github.com/repos/Daki-l/XianYu2/releases/assets/${asset_id}"
  local headers body status status_file location host timeout_seconds hop
  for ((hop = 0; hop <= 3; hop++)); do
    host="$(printf '%s' "$url" | sed -E 's#^https://([^/]+).*$#\1#')"
    [[ "$url" =~ ^https:// && "$host" =~ $allowed_asset_hosts ]] || {
      echo "Release asset redirect uses an untrusted URL: $url" >&2
      return 1
    }

    headers="${destination}.headers.$$"
    body="${destination}.body.$$"
    status_file="${destination}.status.$$"
    rm -f "$headers" "$body" "$status_file"
    if [[ -n "$transfer_phase" ]]; then
      timeout_seconds="$(remaining_timeout_seconds "$DOWNLOAD_MAX_TIMEOUT_SECONDS")"
      begin_transfer "$transfer_phase" "$transfer_total" "$transfer_progress" "$transfer_message" "$transfer_detail"
      # The monitor below treats actual file-byte growth as progress. Do not
      # let curl impose a minimum byte rate or a shorter connect deadline on a
      # slow but still advancing proxy path.
      start_update_curl --fail --silent --show-error --proto '=https' --max-redirs 0 \
        --max-time "$timeout_seconds" \
        --header 'Accept: application/octet-stream' \
        --header 'User-Agent: XianYu2-update-agent' \
        --dump-header "$headers" --output "$body" --write-out '%{http_code}' "$url" > "$status_file" &
      active_transfer_pid=$!
      if ! wait_for_file_transfer "$active_transfer_pid" "$body" "$transfer_progress" "$transfer_message" "$transfer_detail"; then
        rm -f "$headers" "$body" "$status_file"
        return 1
      fi
      status="$(tr -d '\r\n' < "$status_file")"
      rm -f "$status_file"
      finish_transfer
    else
      timeout_seconds="$(remaining_timeout_seconds "$DOWNLOAD_TIMEOUT_SECONDS")"
      if ! status="$(run_update_curl --fail --silent --show-error --proto '=https' --max-redirs 0 \
        --connect-timeout 15 --max-time "$timeout_seconds" \
        --header 'Accept: application/octet-stream' \
        --header 'User-Agent: XianYu2-update-agent' \
        --dump-header "$headers" --output "$body" --write-out '%{http_code}' "$url")"; then
        rm -f "$headers" "$body" "$status_file"
        return 1
      fi
    fi

    if [[ "$status" =~ ^2[0-9][0-9]$ ]]; then
      mv -f "$body" "$destination"
      rm -f "$headers"
      return 0
    fi
    if [[ "$status" =~ ^3[0-9][0-9]$ ]]; then
      location="$(awk 'BEGIN { IGNORECASE = 1 }
        { sub(/\r$/, "") }
        tolower($1) == "location:" {
          sub(/^[^:]*:[[:space:]]*/, "")
          value = $0
        }
        END { print value }' "$headers")"
      rm -f "$headers" "$body"
      [[ -n "$location" ]] || {
        echo 'Release asset redirect is missing a Location header.' >&2
        return 1
      }
      url="$location"
      continue
    fi

    rm -f "$headers" "$body"
    echo "Unexpected HTTP status while downloading release asset: $status" >&2
    return 1
  done

  echo 'Release asset exceeded the redirect limit.' >&2
  return 1
}

restore_verified_jar_cache() {
  local version="$1"
  local name="$2"
  local expected_sha="$3"
  local expected_size="$4"
  local certificate_identity="$5"
  local destination="$6"
  local cache_dir="$UPDATE_WORK_DIR/cache"
  local cached_jar="$cache_dir/app.jar"
  local cached_metadata="$cache_dir/app.jar.json"
  [[ -f "$cached_jar" && ! -L "$cached_jar" && -f "$cached_metadata" && ! -L "$cached_metadata" ]] || return 1
  if (( EUID == 0 )); then
    assert_root_owned_protected_file "$cached_jar" 'Cached JAR' || return 1
    assert_root_owned_protected_file "$cached_metadata" 'Cached JAR metadata' || return 1
  fi
  jq -e --arg version "$version" --arg name "$name" --arg sha "$expected_sha" \
    --argjson size "$expected_size" --arg identity "$certificate_identity" '
      .schemaVersion == 1 and .version == $version and .name == $name and .sha256 == $sha
      and .size == $size and .certificateIdentity == $identity
    ' "$cached_metadata" >/dev/null || return 1
  [[ "$(stat -c '%s' "$cached_jar")" == "$expected_size" ]] || return 1
  [[ "$(sha256sum "$cached_jar" | awk '{print $1}')" == "$expected_sha" ]] || return 1
  cp -- "$cached_jar" "$destination"
  downloaded_bytes="$expected_size"
  total_bytes="$expected_size"
  write_status VERIFYING 40 '复用已验证的应用 JAR 缓存'
}

cache_verified_jar() {
  local version="$1"
  local name="$2"
  local expected_sha="$3"
  local expected_size="$4"
  local certificate_identity="$5"
  local source="$6"
  local cache_dir="$UPDATE_WORK_DIR/cache"
  local cached_jar="$cache_dir/app.jar"
  local cached_metadata="$cache_dir/app.jar.json"
  local temporary_jar="${cached_jar}.tmp.${task_id}"
  local payload
  install -d -m 0750 "$cache_dir"
  cp -- "$source" "$temporary_jar"
  chmod 0640 "$temporary_jar"
  mv -f "$temporary_jar" "$cached_jar"
  payload="$(jq -n \
    --arg version "$version" \
    --arg name "$name" \
    --arg sha "$expected_sha" \
    --argjson size "$expected_size" \
    --arg identity "$certificate_identity" \
    --arg verifiedAt "$(timestamp)" \
    '{schemaVersion: 1, version: $version, name: $name, sha256: $sha, size: $size,
      certificateIdentity: $identity, verifiedAt: $verifiedAt}')"
  write_json_atomically "$cached_metadata" "$payload"
  chmod 0640 "$cached_metadata"
}

write_image_pull_progress() {
  local destination="$1"
  local downloaded="$2"
  local total="$3"
  local current_layer="$4"
  local completed_layers="$5"
  local total_layers="$6"
  local payload
  payload="$(jq -n \
    --argjson downloadedBytes "$downloaded" \
    --argjson totalBytes "$total" \
    --arg currentLayer "$current_layer" \
    --argjson completedLayers "$completed_layers" \
    --argjson totalLayers "$total_layers" \
    '{downloadedBytes: $downloadedBytes, totalBytes: $totalBytes, currentLayer: $currentLayer,
      completedLayers: $completedLayers, totalLayers: $totalLayers}')"
  write_json_atomically "$destination" "$payload"
}

parse_docker_pull_events() {
  local progress_file="$1"
  local error_file="$2"
  declare -A layer_seen=()
  declare -A manifest_layer_seen=()
  declare -A layer_current=()
  declare -A layer_total=()
  declare -A layer_complete=()
  local line daemon_error layer_id event_status current total layer
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if ! jq -e . >/dev/null 2>&1 <<< "$line"; then
      printf '%s\n' 'Docker daemon returned an invalid image-pull progress record.' > "$error_file"
      return 1
    fi
    daemon_error="$(jq -r '
      if (.error? | type) == "string" then
        if (.error | length) > 0 then .error else "" end
      else "" end
    ' <<< "$line")"
    if [[ -n "$daemon_error" ]]; then
      # Do not persist a registry response because it may contain untrusted text.
      printf '%s\n' 'Docker daemon rejected the image pull.' > "$error_file"
      return 1
    fi
    layer_id="$(jq -r '
      if (.id? | type) == "string" then
        .id | if test("^[A-Za-z0-9:_-]{1,128}$") then . else "" end
      else "" end
    ' <<< "$line")"
    [[ -n "$layer_id" ]] || continue
    event_status="$(jq -r 'if (.status? | type) == "string" then .status else "" end' <<< "$line")"
    current="$(jq -r '(.progressDetail.current? // 0) | if type == "number" then if . >= 0 and . == floor then . else 0 end else 0 end' <<< "$line")"
    total="$(jq -r '(.progressDetail.total? // 0) | if type == "number" then if . >= 0 and . == floor then . else 0 end else 0 end' <<< "$line")"
    layer_seen["$layer_id"]=1
    # The daemon emits one of these after resolving the image manifest for
    # every filesystem layer, before it starts reporting byte progress.
    [[ "$event_status" == 'Pulling fs layer' ]] && manifest_layer_seen["$layer_id"]=1
    if (( total > ${layer_total[$layer_id]:-0} )); then
      layer_total["$layer_id"]="$total"
    fi
    if (( current > ${layer_current[$layer_id]:-0} )); then
      layer_current["$layer_id"]="$current"
    fi
    case "$event_status" in
      'Download complete'|'Pull complete'|'Already exists')
        layer_complete["$layer_id"]=1
        if (( ${layer_total[$layer_id]:-0} > 0 )); then
          layer_current["$layer_id"]="${layer_total[$layer_id]}"
        fi
        ;;
    esac

    local aggregate_downloaded=0 aggregate_total=0 completed_layers=0 total_layers=0
    local -a aggregate_layers=("${!manifest_layer_seen[@]}")
    # Keep compatibility with nonstandard daemon streams that omit the
    # manifest marker, while normal Docker engines use the manifest count.
    (( ${#aggregate_layers[@]} > 0 )) || aggregate_layers=("${!layer_seen[@]}")
    for layer in "${aggregate_layers[@]}"; do
      total_layers=$((total_layers + 1))
      aggregate_downloaded=$((aggregate_downloaded + ${layer_current[$layer]:-0}))
      aggregate_total=$((aggregate_total + ${layer_total[$layer]:-0}))
      [[ "${layer_complete[$layer]:-0}" == '1' ]] && completed_layers=$((completed_layers + 1))
    done
    write_image_pull_progress "$progress_file" "$aggregate_downloaded" "$aggregate_total" \
      "$layer_id" "$completed_layers" "$total_layers"
  done
}

refresh_image_pull_progress() {
  local progress_file="$1"
  [[ -f "$progress_file" ]] || return 0
  local downloaded total current_layer completed_layers total_layers
  if ! IFS=$'\t' read -r downloaded total current_layer completed_layers total_layers < <(
    jq -r '[.downloadedBytes, .totalBytes, .currentLayer, .completedLayers, .totalLayers] | @tsv' "$progress_file"
  ); then
    return 1
  fi
  [[ "$downloaded" =~ ^[0-9]+$ && "$total" =~ ^[0-9]+$ && "$completed_layers" =~ ^[0-9]+$ && "$total_layers" =~ ^[0-9]+$ ]] || return 1
  update_transfer_state "$downloaded" "$total" "$current_layer" "$completed_layers" "$total_layers"
}

wait_for_image_pull() {
  local progress_file="$1"
  local error_file="$2"
  local progress="$3"
  local message="$4"
  local detail="$5"
  local now abort_reason='' curl_exit=0 parser_exit=0

  while kill -0 "$active_transfer_pid" 2>/dev/null; do
    if consume_cancellation_request; then
      abort_reason="$transfer_failure_detail"
    fi
    if [[ -z "$abort_reason" ]]; then
      refresh_image_pull_progress "$progress_file" || {
        transfer_failure_detail='Docker image-pull progress could not be parsed.'
        abort_reason="$transfer_failure_detail"
      }
    fi
    publish_transfer_status "$progress" "$message" "$detail"
    now="$(date +%s)"
    if [[ -z "$abort_reason" && -f "$error_file" ]]; then
      transfer_failure_detail='Docker daemon rejected the image pull.'
      abort_reason="$transfer_failure_detail"
    elif [[ -z "$abort_reason" ]] && (( now >= transfer_deadline_epoch )); then
      transfer_failure_detail="镜像下载超过最长允许时长 ${DOWNLOAD_MAX_TIMEOUT_SECONDS} 秒，已停止。"
      abort_reason="$transfer_failure_detail"
    elif [[ -z "$abort_reason" ]] && (( now - transfer_last_progress_epoch >= DOWNLOAD_IDLE_TIMEOUT_SECONDS )); then
      transfer_failure_detail="镜像下载连续 ${DOWNLOAD_IDLE_TIMEOUT_SECONDS} 秒无字节增长，已停止。"
      abort_reason="$transfer_failure_detail"
    fi
    if [[ -n "$abort_reason" ]]; then
      kill -TERM "$active_transfer_pid" 2>/dev/null || true
      break
    fi
    sleep 1
  done

  refresh_image_pull_progress "$progress_file" || true
  publish_transfer_status "$progress" "$message" "$detail"
  # The curl process can exit before the next polling iteration after the
  # parser has already recorded a daemon-side failure. Preserve that safe,
  # agent-generated diagnostic instead of reducing it to a generic error.
  if [[ -f "$error_file" ]]; then
    transfer_failure_detail="$(<"$error_file")"
  fi
  if wait "$active_transfer_pid"; then
    curl_exit=0
  else
    curl_exit=$?
  fi
  active_transfer_pid=''
  if wait "$active_transfer_parser_pid"; then
    parser_exit=0
  else
    parser_exit=$?
  fi
  active_transfer_parser_pid=''
  rm -f "$active_transfer_fifo"
  active_transfer_fifo=''

  [[ -z "$abort_reason" ]] || return 124
  if (( curl_exit != 0 || parser_exit != 0 )); then
    [[ -n "$transfer_failure_detail" ]] || transfer_failure_detail='Docker image pull failed.'
    return 1
  fi
}

pull_image_with_progress() {
  local image_reference="$1"
  local progress_file="$download_dir/image-pull-progress.json"
  local error_file="$download_dir/image-pull-error.txt"
  local timeout_seconds
  rm -f "$progress_file" "$error_file"
  active_transfer_fifo="$download_dir/image-pull-events.fifo"
  rm -f "$active_transfer_fifo"
  mkfifo -m 0600 "$active_transfer_fifo"
  timeout_seconds="$(remaining_timeout_seconds "$DOWNLOAD_MAX_TIMEOUT_SECONDS")"
  begin_transfer IMAGE_PULL 0 75 '正在拉取新的不可变镜像'
  (
    # A registry error is reported to the parent through error_file. Do not let
    # this parser child claim/archive the task through the inherited ERR trap.
    trap - ERR
    parse_docker_pull_events "$progress_file" "$error_file" < "$active_transfer_fifo"
  ) &
  active_transfer_parser_pid=$!
  start_docker_engine_curl --fail --silent --show-error --no-buffer --request POST --get \
    --max-time "$timeout_seconds" \
    --data-urlencode "fromImage=${image_reference}" http://localhost/images/create > "$active_transfer_fifo" &
  active_transfer_pid=$!
  if ! wait_for_image_pull "$progress_file" "$error_file" 75 '正在拉取新的不可变镜像' ''; then
    rm -f "$progress_file" "$error_file"
    return 1
  fi
  if consume_cancellation_request; then
    rm -f "$progress_file" "$error_file"
    return 1
  fi
  rm -f "$progress_file" "$error_file"
  finish_transfer
  run_with_timeout "$DOWNLOAD_TIMEOUT_SECONDS" docker image inspect "$image_reference" >/dev/null
}

validate_host_package_archive() {
  local archive="$1"
  local version="$2"
  local prefix="xianyu2-host-package-v${version}/"
  local listing="$download_dir/host-package-contents.txt"
  local verbose_listing="$download_dir/host-package-verbose.txt"
  local entry relative normalized record required
  declare -A members=()

  [[ -f "$archive" && ! -L "$archive" ]] || {
    echo 'Host package must be a regular archive file.' >&2
    return 1
  }
  tar -tzf "$archive" > "$listing"
  tar -tvzf "$archive" > "$verbose_listing"

  while IFS= read -r entry || [[ -n "$entry" ]]; do
    [[ "$entry" == "$prefix"* ]] || {
      echo "Host package contains an unexpected path: $entry" >&2
      return 1
    }
    relative="${entry#"$prefix"}"
    [[ -z "$relative" ]] && continue
    normalized="${relative%/}"
    [[ -n "$normalized" && "$normalized" != '.' && "$normalized" != /* && "$normalized" != *$'\r'* ]] || {
      echo "Host package contains an unsafe path: $entry" >&2
      return 1
    }
    case "/${normalized}/" in
      *'/../'*|*'//'*)
        echo "Host package contains an unsafe path: $entry" >&2
        return 1
        ;;
    esac
    case "$relative" in
      .env.example|compose.yaml|deploy/|deploy/nginx/|deploy/server/|deploy/update/|\
      deploy/nginx/*|deploy/server/*|deploy/update/*) ;;
      *)
        echo "Host package path is outside the managed allowlist: $entry" >&2
        return 1
        ;;
    esac
    [[ -z "${members[$relative]:-}" ]] || {
      echo "Host package contains a duplicate path: $entry" >&2
      return 1
    }
    members["$relative"]=1
  done < "$listing"

  while IFS= read -r record || [[ -n "$record" ]]; do
    case "${record:0:1}" in
      -|d) ;;
      *)
        echo 'Host package may only contain regular files and directories.' >&2
        return 1
        ;;
    esac
  done < "$verbose_listing"

  for required in \
    '.env.example' \
    'compose.yaml' \
    'deploy/update/agent-version' \
    'deploy/update/xianyu2-update-agent' \
    'deploy/update/xianyu2-update-agent.service' \
    'deploy/update/xianyu2-update-agent.path' \
    'deploy/update/update-agent.conf.example' \
    'deploy/update/backup-mysql' \
    'deploy/update/install-update-agent.sh' \
    'deploy/update/install-release.sh'; do
    [[ "${members[$required]:-}" == 1 ]] || {
      echo "Host package is missing a required path: $required" >&2
      return 1
    }
  done
}

extract_verified_host_package() {
  local archive="$1"
  local stage="$download_dir/host-package"
  local required
  mkdir -p "$stage"
  tar --extract --gzip --file "$archive" --directory "$stage" --strip-components=1 \
    --no-same-owner --no-same-permissions --numeric-owner
  for required in \
    '.env.example' \
    'compose.yaml' \
    'deploy/update/agent-version' \
    'deploy/update/xianyu2-update-agent' \
    'deploy/update/xianyu2-update-agent.service' \
    'deploy/update/xianyu2-update-agent.path' \
    'deploy/update/update-agent.conf.example' \
    'deploy/update/backup-mysql' \
    'deploy/update/install-update-agent.sh' \
    'deploy/update/install-release.sh'; do
    [[ -f "$stage/$required" && ! -L "$stage/$required" ]] || {
      echo "Extracted host package path is invalid: $required" >&2
      return 1
    }
  done
  [[ -d "$stage/deploy" && ! -L "$stage/deploy" ]] || {
    echo 'Extracted host package deploy directory is invalid.' >&2
    return 1
  }
  printf '%s\n' "$stage"
}

validate_staged_host_agent_version() {
  local stage="$1"
  local minimum_version="$2"
  local staged_version
  staged_version="$(tr -d '[:space:]' < "$stage/deploy/update/agent-version")"
  [[ "$staged_version" =~ ^[1-9][0-9]*$ ]] || {
    echo 'Host package contains an invalid update-agent version.' >&2
    return 1
  }
  (( 10#$staged_version >= 10#$minimum_version )) || {
    echo "Host package agent version ${staged_version} is below manifest minimum ${minimum_version}." >&2
    return 1
  }
  (( 10#$staged_version >= 10#$agent_version )) || {
    echo "Refusing to replace update agent ${agent_version} with older version ${staged_version}." >&2
    return 1
  }
}

prepare_host_package_project_stage() {
  local extracted_stage="$1"
  local existing_link
  [[ "$PROJECT_DIR" != *[[:space:]]* ]] || {
    echo 'Automatic host-package installation requires PROJECT_DIR without whitespace.' >&2
    return 1
  }
  assert_root_owned_protected_directory "$PROJECT_DIR" 'Project directory'
  [[ -d "$PROJECT_DIR/deploy" && ! -L "$PROJECT_DIR/deploy" ]] || {
    echo 'Project deploy directory must be a real directory before automatic host-package installation.' >&2
    return 1
  }
  existing_link="$(find "$PROJECT_DIR/deploy" -type l -print -quit)"
  [[ -z "$existing_link" ]] || {
    echo 'Project deploy directory contains a symbolic link; refusing automatic replacement.' >&2
    return 1
  }
  host_package_project_stage="$(mktemp -d "$PROJECT_DIR/.xianyu2-host-stage.${task_id}.XXXXXX")"
  chmod 0700 "$host_package_project_stage"
  cp -- "$extracted_stage/.env.example" "$host_package_project_stage/.env.example"
  cp -- "$extracted_stage/compose.yaml" "$host_package_project_stage/compose.yaml"
  # Preserve administrator-managed files below deploy/ while atomically
  # replacing the package-owned entries. The archive itself is allowlisted.
  cp -a --no-preserve=ownership -- "$PROJECT_DIR/deploy" "$host_package_project_stage/deploy"
  cp -a --no-preserve=ownership -- "$extracted_stage/deploy/." "$host_package_project_stage/deploy/"
  if (( EUID == 0 )); then
    chown -R root:root "$host_package_project_stage"
  fi
}

backup_host_package_inputs() {
  local entry
  host_package_backup_dir="$UPDATE_WORK_DIR/archive/host-package-${task_id}"
  [[ ! -e "$host_package_backup_dir" ]] || {
    echo "Host package backup already exists: $host_package_backup_dir" >&2
    return 1
  }
  install -d -m 0750 "$host_package_backup_dir"
  for entry in '.env.example' 'compose.yaml' 'deploy'; do
    [[ -e "$PROJECT_DIR/$entry" && ! -L "$PROJECT_DIR/$entry" ]] || {
      echo "Cannot back up unmanaged or missing project path: $PROJECT_DIR/$entry" >&2
      return 1
    }
    cp -a -- "$PROJECT_DIR/$entry" "$host_package_backup_dir/$entry"
  done
}

backup_installed_agent_component() {
  local source="$1"
  local name="$2"
  local backup_root="$host_package_backup_dir/agent-components"
  local snapshot="$backup_root/$name"
  local marker="$backup_root/$name.state"
  install -d -m 0750 "$backup_root" || return 1
  if [[ -e "$source" || -L "$source" ]]; then
    [[ -f "$source" && ! -L "$source" ]] || {
      echo "Installed update-agent component is not a regular file: $source" >&2
      return 1
    }
    cp -a -- "$source" "$snapshot" || return 1
    printf 'present\n' > "$marker" || return 1
  else
    printf 'absent\n' > "$marker" || return 1
  fi
}

backup_installed_agent_components() {
  # Non-root test runs use a fake installer in an isolated temporary project;
  # they must never inspect or alter the workstation's systemd installation.
  if (( EUID != 0 )) && [[ "${XIANYU2_UPDATE_AGENT_TEST_MODE:-false}" == 'true' ]]; then
    return 0
  fi
  backup_installed_agent_component /usr/local/lib/xianyu2/xianyu2-update-agent agent || return 1
  backup_installed_agent_component /usr/local/lib/xianyu2/agent-version agent-version || return 1
  backup_installed_agent_component /usr/local/lib/xianyu2/backup-mysql backup-mysql || return 1
  backup_installed_agent_component /etc/systemd/system/xianyu2-update-agent.service service || return 1
  backup_installed_agent_component /etc/systemd/system/xianyu2-update-agent.path path || return 1
  backup_installed_agent_component /etc/systemd/system/xianyu2-update-agent.service.d/project-dir.conf project-dir || return 1
}

restore_installed_agent_component() {
  local destination="$1"
  local name="$2"
  local backup_root="$host_package_backup_dir/agent-components"
  local snapshot="$backup_root/$name"
  local marker="$backup_root/$name.state"
  local state temporary
  [[ -f "$marker" ]] || return 0
  state="$(<"$marker")"
  case "$state" in
    present)
      install -d -m 0755 "$(dirname "$destination")" || return 1
      temporary="$(mktemp "$(dirname "$destination")/.${destination##*/}.restore.XXXXXX")" || return 1
      cp -a --no-preserve=ownership -- "$snapshot" "$temporary" || return 1
      chown root:root "$temporary" || return 1
      mv -f -- "$temporary" "$destination" || return 1
      ;;
    absent)
      rm -f -- "$destination" || return 1
      ;;
    *)
      echo "Invalid update-agent component backup state: $name" >&2
      return 1
      ;;
  esac
}

restore_installed_agent_components() {
  if (( EUID != 0 )) && [[ "${XIANYU2_UPDATE_AGENT_TEST_MODE:-false}" == 'true' ]]; then
    return 0
  fi
  restore_installed_agent_component /usr/local/lib/xianyu2/xianyu2-update-agent agent || return 1
  restore_installed_agent_component /usr/local/lib/xianyu2/agent-version agent-version || return 1
  restore_installed_agent_component /usr/local/lib/xianyu2/backup-mysql backup-mysql || return 1
  restore_installed_agent_component /etc/systemd/system/xianyu2-update-agent.service service || return 1
  restore_installed_agent_component /etc/systemd/system/xianyu2-update-agent.path path || return 1
  restore_installed_agent_component /etc/systemd/system/xianyu2-update-agent.service.d/project-dir.conf project-dir || return 1
  systemctl daemon-reload
}

restore_host_package_inputs() {
  [[ -n "$host_package_backup_dir" && -d "$host_package_backup_dir" ]] || return 1
  local entry temporary failed_deploy restored_deploy
  for entry in '.env.example' 'compose.yaml'; do
    temporary="$(mktemp "$PROJECT_DIR/.xianyu2-host-restore-file.XXXXXX")" || return 1
    cp -a --no-preserve=ownership -- "$host_package_backup_dir/$entry" "$temporary" || return 1
    if (( EUID == 0 )); then
      chown root:root "$temporary" || return 1
    fi
    mv -f -- "$temporary" "$PROJECT_DIR/$entry" || return 1
  done

  failed_deploy="$PROJECT_DIR/.xianyu2-host-failed-deploy.${task_id}.${RANDOM}"
  if [[ -e "$PROJECT_DIR/deploy" || -L "$PROJECT_DIR/deploy" ]]; then
    mv -- "$PROJECT_DIR/deploy" "$failed_deploy" || return 1
  fi
  restored_deploy="$PROJECT_DIR/.xianyu2-host-restore-deploy.${task_id}.${RANDOM}"
  cp -a --no-preserve=ownership -- "$host_package_backup_dir/deploy" "$restored_deploy" || return 1
  if (( EUID == 0 )); then
    chown -R root:root "$restored_deploy" || return 1
  fi
  mv -- "$restored_deploy" "$PROJECT_DIR/deploy" || return 1
}

apply_staged_host_package() {
  backup_host_package_inputs
  prepare_host_package_project_stage "$1"

  if ! mv -f -- "$host_package_project_stage/.env.example" "$PROJECT_DIR/.env.example"; then
    restore_host_package_inputs || true
    return 1
  fi
  if ! mv -f -- "$host_package_project_stage/compose.yaml" "$PROJECT_DIR/compose.yaml"; then
    restore_host_package_inputs || true
    return 1
  fi

  host_package_previous_deploy="$PROJECT_DIR/.xianyu2-host-previous-deploy.${task_id}.${RANDOM}"
  if ! mv -- "$PROJECT_DIR/deploy" "$host_package_previous_deploy"; then
    restore_host_package_inputs || true
    return 1
  fi
  if ! mv -- "$host_package_project_stage/deploy" "$PROJECT_DIR/deploy"; then
    mv -- "$host_package_previous_deploy" "$PROJECT_DIR/deploy" 2>/dev/null || true
    restore_host_package_inputs || true
    return 1
  fi
  rmdir "$host_package_project_stage" 2>/dev/null || true
  host_package_project_stage=''
}

discard_host_package_swap_backup() {
  [[ -n "$host_package_previous_deploy" && -d "$host_package_previous_deploy" ]] || return 0
  rm -rf -- "$host_package_previous_deploy"
  host_package_previous_deploy=''
}

mark_self_update_handoff() {
  local temporary payload
  [[ -n "$task_id" && -n "$task_file" && -f "$task_file" && ! -L "$task_file" ]] || {
    echo 'The active update task is unavailable for the self-update hand-off.' >&2
    return 1
  }
  payload="$(jq -ce --arg taskId "$task_id" --arg version "$task_version" \
    --arg startedAt "$task_started_at" '
      if .schemaVersion == 1 and .taskId == $taskId and .version == $version
      then .selfUpdateHandoff = {completedAt: (now | todateiso8601), taskStartedAt: $startedAt}
      else error("active update task does not match the self-update hand-off")
      end
    ' "$task_file")" || return 1
  temporary="$(mktemp "$UPDATE_WORK_DIR/in-progress/.${task_id}.self-update.XXXXXX")" || return 1
  printf '%s\n' "$payload" > "$temporary"
  chmod 0600 "$temporary"
  if (( EUID == 0 )); then
    chown root:root "$temporary"
  fi
  mv -f -- "$temporary" "$task_file"
}

resume_self_updated_task() {
  local resume_task_id="$1"
  local recorded_task_id recorded_version recorded_tag recorded_started_at remaining_task
  [[ "$resume_task_id" =~ ^[0-9a-fA-F-]{36}$ ]] || {
    echo 'Invalid self-update hand-off task identifier.' >&2
    return 64
  }
  task_file="$UPDATE_WORK_DIR/in-progress/${resume_task_id}.json"
  [[ -f "$task_file" && ! -L "$task_file" ]] || {
    echo 'The self-update hand-off task is unavailable.' >&2
    return 1
  }
  remaining_task="$(find "$UPDATE_WORK_DIR/in-progress" -maxdepth 1 -type f -name '*.json' ! -name "${resume_task_id}.json" -print -quit)"
  [[ -z "$remaining_task" ]] || {
    echo 'Another unfinished update task exists; refusing an ambiguous self-update hand-off.' >&2
    return 1
  }
  recorded_task_id="$(jq -er '.taskId' "$task_file")"
  recorded_version="$(jq -er '.version' "$task_file")"
  recorded_tag="$(jq -er '.releaseTag' "$task_file")"
  recorded_started_at="$(jq -er '.selfUpdateHandoff.taskStartedAt' "$task_file")"
  [[ "$recorded_task_id" == "$resume_task_id" && "$recorded_tag" =~ $release_tag_pattern ]] || {
    echo 'The self-update hand-off task is invalid.' >&2
    return 1
  }
  [[ "$recorded_version" == "${recorded_tag#v}" ]] && is_release_version "$recorded_version" || {
    echo 'The self-update hand-off task has an invalid version.' >&2
    return 1
  }
  date --date="$recorded_started_at" +%s >/dev/null 2>&1 || {
    echo 'The self-update hand-off task has an invalid start time.' >&2
    return 1
  }
  task_id="$recorded_task_id"
  task_version="$recorded_version"
  task_started_at="$recorded_started_at"
}

continue_with_updated_agent() {
  local staged_agent="$1"
  local updated_agent
  [[ -f "$staged_agent" && ! -L "$staged_agent" ]] || {
    echo 'The staged update agent is unavailable.' >&2
    return 1
  }

  mark_self_update_handoff
  # Keep the original private task and task ID. The new agent resumes it from
  # the exact Release tag rather than manufacturing a second manual task.
  write_status INSTALLING 68 '宿主机更新组件已安装，正在由新更新代理继续部署'
  stop_heartbeat
  stop_task_timeout
  if [[ "${XIANYU2_UPDATE_AGENT_TEST_MODE:-false}" == 'true' && "$EUID" -ne 0 ]]; then
    # The isolated regression fixture deliberately never writes /usr/local.
    updated_agent="$staged_agent"
  else
    updated_agent='/usr/local/lib/xianyu2/xianyu2-update-agent'
    [[ -f "$updated_agent" && ! -L "$updated_agent" ]] || {
      echo 'The installed update agent is unavailable after self-update.' >&2
      return 1
    }
    cleanup_download_dir
    download_dir=''
  fi
  # The service process becomes the installed agent. Closing this descriptor
  # lets the new process re-acquire the same lock without a second service run.
  exec 9>&-
  exec bash "$updated_agent" --resume-host-package-update "$task_id"
}

auto_apply_host_package_update() {
  local release_json="$1"
  local target_version="$2"
  local host_package_name="$3"
  local host_package_sha="$4"
  local host_package_size="$5"
  local minimum_agent_version="$6"
  local certificate_identity="$7"
  local host_package host_package_bundle extracted_stage

  # The test harness runs an isolated, non-root filesystem and never grants
  # host privileges. Production systemd invocations must always remain root.
  (( EUID == 0 )) || [[ "${XIANYU2_UPDATE_AGENT_TEST_MODE:-false}" == 'true' ]] || {
    echo 'Automatic host-package installation requires the root systemd update agent.' >&2
    return 1
  }
  (( host_package_size <= 67108864 )) || {
    echo 'Host package exceeds the 64 MiB automatic-installation limit.' >&2
    return 1
  }
  host_package="$download_dir/$host_package_name"
  host_package_bundle="$download_dir/${host_package_name}.bundle"

  download_api_asset "$(release_asset_id "$release_json" "$host_package_name")" "$host_package" \
    HOST_PACKAGE_DOWNLOAD "$host_package_size" 20 '正在下载宿主机更新包'
  [[ "$(stat -c '%s' "$host_package")" == "$host_package_size" ]] || {
    echo 'Downloaded host package size does not match the signed manifest.' >&2
    return 1
  }
  write_status VERIFYING 35 '正在验证宿主机更新包签名和校验和'
  download_api_asset "$(release_asset_id "$release_json" "${host_package_name}.bundle")" "$host_package_bundle"
  verify_blob "$host_package" "$host_package_bundle" "$certificate_identity"
  [[ "$(sha256sum "$host_package" | awk '{print $1}')" == "$host_package_sha" ]] || {
    echo 'Host package checksum does not match the signed manifest.' >&2
    return 1
  }
  validate_host_package_archive "$host_package" "$target_version"
  extracted_stage="$(extract_verified_host_package "$host_package")"
  validate_staged_host_agent_version "$extracted_stage" "$minimum_agent_version"

  write_status INSTALLING 48 '正在备份受管宿主机组件'
  apply_staged_host_package "$extracted_stage"
  if ! backup_installed_agent_components; then
    restore_host_package_inputs || true
    return 1
  fi
  write_status INSTALLING 60 '正在安装受管宿主机组件'
  if ! XIANYU2_UPDATE_AGENT_SELF_UPDATE=true bash "$PROJECT_DIR/deploy/update/install-update-agent.sh"; then
    restore_host_package_inputs || true
    restore_installed_agent_components || true
    return 1
  fi
  discard_host_package_swap_backup
  continue_with_updated_agent "$extracted_stage/deploy/update/xianyu2-update-agent"
}

release_certificate_identity() {
  local release_tag="$1"
  printf '%s%s\n' "$cosign_identity_prefix" "$release_tag"
}

verify_blob() {
  local artifact="$1"
  local bundle="$2"
  local certificate_identity="$3"
  run_update_cosign "$DOWNLOAD_TIMEOUT_SECONDS" cosign verify-blob \
    --certificate-identity "$certificate_identity" \
    --certificate-oidc-issuer "$COSIGN_OIDC_ISSUER" \
    --bundle "$bundle" "$artifact" >/dev/null
}

release_asset_id() {
  local release_json="$1"
  local asset_name="$2"
  jq -er --arg name "$asset_name" '
    [.assets[] | select(.name == $name and (.id | type == "number")) | .id]
    | if length == 1 then .[0] else error("asset must appear exactly once") end
  ' "$release_json"
}

read_release_env_digest() {
  [[ -f "$RELEASE_ENV_FILE" ]] || return 1
  sed -n 's/^APP_IMAGE_DIGEST=//p' "$RELEASE_ENV_FILE" | head -n 1
}

write_release_env() {
  local digest="$1"
  [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || {
    echo "Invalid image digest" >&2
    return 1
  }
  local tmp="${RELEASE_ENV_FILE}.tmp.$$"
  install -d -m 0750 "$(dirname "$RELEASE_ENV_FILE")"
  printf 'APP_IMAGE=%s@%s\nAPP_IMAGE_DIGEST=%s\n' "$RELEASE_REPOSITORY" "$digest" "$digest" > "$tmp"
  chmod 0640 "$tmp"
  mv -f "$tmp" "$RELEASE_ENV_FILE"
}

compose() {
  run_with_timeout "$HEALTH_TIMEOUT_SECONDS" docker compose --project-directory "$PROJECT_DIR" \
    --env-file "$ENV_FILE" --env-file "$RELEASE_ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

prepare_app_network_override() {
  # A service-only Compose update must not reconcile or recreate an existing
  # project network. Older containers can retain a different Compose network
  # hash while a database is still attached, in which case Compose otherwise
  # tries to remove the shared network before it recreates only the app.
  local compose_config network_list network_key network_name discovered_network
  local override has_existing_network=false
  [[ -n "$download_dir" && -d "$download_dir" ]] || {
    echo 'A private download directory is required before preparing the Compose network override.' >&2
    return 1
  }
  if ! compose_config="$(compose config --format json)"; then
    echo 'Unable to resolve the current Compose network configuration before recreating the app.' >&2
    return 1
  fi
  if ! network_list="$(jq -r '
    (.networks // {})
    | to_entries[]
    | select((.value.external // false) | not)
    | [.key, (.value.name // .key)]
    | @tsv
  ' <<< "$compose_config")"; then
    echo 'Unable to parse the current Compose network configuration before recreating the app.' >&2
    return 1
  fi

  override="$(mktemp "$download_dir/.compose-networks.XXXXXX.yaml")"
  chmod 0600 "$override"
  printf 'networks:\n' > "$override"
  while IFS=$'\t' read -r network_key network_name; do
    [[ -n "$network_key" && -n "$network_name" ]] || continue
    [[ "$network_key" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] \
      && [[ "$network_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || {
      echo 'Compose network names contain unsupported characters for the protected update override.' >&2
      rm -f "$override"
      return 1
    }
    if ! discovered_network="$(run_with_timeout "$HEALTH_TIMEOUT_SECONDS" \
      docker network inspect --format '{{.Name}}' "$network_name" 2>/dev/null)"; then
      # The network does not exist yet. Compose remains responsible for
      # creating it, which is required during an initial installation.
      continue
    fi
    [[ "$discovered_network" == "$network_name" ]] || {
      echo 'Docker reported an unexpected Compose network while preparing the app update.' >&2
      rm -f "$override"
      return 1
    }
    printf '  %s:\n    external: true\n    name: %s\n' "$network_key" "$network_name" >> "$override"
    has_existing_network=true
  done <<< "$network_list"

  if [[ "$has_existing_network" != 'true' ]]; then
    rm -f "$override"
    return 0
  fi
  printf '%s\n' "$override"
}

recreate_app() {
  local network_override=''
  network_override="$(prepare_app_network_override)" || return 1
  if [[ -n "$network_override" ]]; then
    run_with_timeout "$HEALTH_TIMEOUT_SECONDS" docker compose --project-directory "$PROJECT_DIR" \
      --env-file "$ENV_FILE" --env-file "$RELEASE_ENV_FILE" -f "$COMPOSE_FILE" -f "$network_override" \
      up -d --no-deps --force-recreate app
  else
    compose up -d --no-deps --force-recreate app
  fi
}

wait_for_health() {
  local elapsed=0
  while (( elapsed < HEALTH_TIMEOUT_SECONDS )); do
    local container health
    container="$(compose ps -q app)"
    if [[ -n "$container" ]]; then
      health="$(run_with_timeout "$HEALTH_TIMEOUT_SECONDS" docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)"
      if [[ "$health" == 'healthy' ]] \
        && run_with_timeout "$HEALTH_TIMEOUT_SECONDS" docker exec "$container" wget -q -O /dev/null http://127.0.0.1:12400/actuator/health; then
        return 0
      fi
    fi
    write_status HEALTH_CHECKING 92 "等待应用健康检查" "已等待 ${elapsed} 秒"
    sleep 5
    elapsed=$((elapsed + 5))
  done
  return 1
}

write_installed_state() {
  local version="$1"
  local jar_sha="$2"
  local fingerprint="$3"
  local image_digest="$4"
  local source="$5"
  local payload
  payload="$(jq -n \
    --arg version "$version" \
    --arg jarSha256 "$jar_sha" \
    --arg runtimeFingerprint "$fingerprint" \
    --arg imageDigest "$image_digest" \
    --arg source "$source" \
    --arg completedAt "$(timestamp)" \
    '{schemaVersion: 1, version: $version, jarSha256: $jarSha256,
      runtimeFingerprint: $runtimeFingerprint, imageDigest: $imageDigest,
      source: $source, completedAt: $completedAt}')"
  write_json_atomically "$RUNTIME_DIR/installed.json" "$payload"
}

backup_if_required() {
  local manifest="$1"
  local required
  jq -e '(.database.requiresBackup // false) | type == "boolean"' "$manifest" >/dev/null
  required="$(jq -r '.database.requiresBackup // false' "$manifest")"
  [[ "$required" == 'true' ]] || return 0
  [[ -n "$BACKUP_HOOK" && -x "$BACKUP_HOOK" ]] || {
    echo 'This release requires a database backup, but BACKUP_HOOK is unavailable.' >&2
    return 1
  }
  write_status BACKING_UP 55 '正在备份数据库'
  local backup_output
  backup_output="$(PROJECT_DIR="$PROJECT_DIR" COMPOSE_FILE="$COMPOSE_FILE" ENV_FILE="$ENV_FILE" \
    RELEASE_ENV_FILE="$RELEASE_ENV_FILE" run_with_timeout "$BACKUP_TIMEOUT_SECONDS" "$BACKUP_HOOK")"
  backup_path="$(printf '%s\n' "$backup_output" | tail -n 1)"
  [[ -n "$backup_path" && -f "$backup_path" && -f "${backup_path}.sha256" ]] || {
    echo 'Backup hook did not return a verifiable backup file.' >&2
    return 1
  }
  backup_sha256="$(sha256sum "$backup_path" | awk '{print $1}')"
  [[ "$(awk '{print $1}' "${backup_path}.sha256")" == "$backup_sha256" ]] || {
    echo 'Backup checksum file does not match the generated backup.' >&2
    return 1
  }
}

restore_release_env_snapshot() {
  local previous_release_env="$1"
  local had_previous_release_env="$2"
  if [[ "$had_previous_release_env" == 'true' ]]; then
    local restore_release_env="${RELEASE_ENV_FILE}.restore.${task_id}.tmp"
    cp "$previous_release_env" "$restore_release_env"
    mv -f "$restore_release_env" "$RELEASE_ENV_FILE"
  else
    rm -f "$RELEASE_ENV_FILE"
  fi
}

process_task() {
  local manual_approved="${1:-false}"
  transfer_failure_detail=''
  transfer_cancelled=false
  start_task_timeout
  local requested_tag release_json manifest manifest_bundle jar jar_bundle
  requested_tag="$(jq -r '.releaseTag // empty' "$task_file")"
  [[ "$requested_tag" =~ $release_tag_pattern ]] || {
    echo 'Invalid requested release tag.' >&2
    return 1
  }

  download_dir="$(mktemp -d "$UPDATE_WORK_DIR/.download.XXXXXX")"
  release_json="$download_dir/release.json"
  write_status CHECKING 5 '正在读取正式发行版'
  github_api_get "$(release_api_for_tag "$requested_tag")" "$release_json"
  [[ "$(jq -r '.draft or .prerelease' "$release_json")" == 'false' ]] || {
    echo 'Draft or prerelease cannot be installed.' >&2
    return 1
  }
  [[ "$(jq -r '.tag_name' "$release_json")" == "$requested_tag" ]] || return 1

  manifest="$download_dir/release-manifest.json"
  manifest_bundle="$download_dir/release-manifest.json.bundle"
  download_api_asset "$(release_asset_id "$release_json" 'release-manifest.json')" "$manifest"
  download_api_asset "$(release_asset_id "$release_json" 'release-manifest.json.bundle')" "$manifest_bundle"
  local certificate_identity
  certificate_identity="$(release_certificate_identity "$requested_tag")"
  verify_blob "$manifest" "$manifest_bundle" "$certificate_identity"

  if [[ "$(jq -r '.schemaVersion // empty' "$manifest")" != '1' ]]; then
    write_status MANUAL_REQUIRED 100 '更新协议版本不受支持' \
      '请先安装本 Release 中经过验证的 host package 和更新代理，再重新检查更新。'
    archive_task
    return 0
  fi

  local target_version update_type fingerprint image_repo image_digest jar_name jar_sha jar_size host_package_name host_package_sha host_package_size manifest_commit minimum_agent_version
  target_version="$(jq -er '.version' "$manifest")"
  update_type="$(jq -er '.updateType' "$manifest")"
  manifest_commit="$(jq -er '.commitSha' "$manifest")"
  minimum_agent_version="$(jq -er '.minimumAgentVersion' "$manifest")"
  fingerprint="$(jq -er '.runtimeFingerprint' "$manifest")"
  image_repo="$(jq -er '.image.repository' "$manifest")"
  image_digest="$(jq -er '.image.digest' "$manifest")"
  jar_name="$(jq -er '.jar.name' "$manifest")"
  jar_sha="$(jq -er '.jar.sha256' "$manifest")"
  jar_size="$(jq -er '.jar.size' "$manifest")"
  host_package_name="$(jq -er '.hostPackage.name' "$manifest")"
  host_package_sha="$(jq -er '.hostPackage.sha256' "$manifest")"
  host_package_size="$(jq -er '.hostPackage.size' "$manifest")"
  [[ "$(jq -r '.releaseTag' "$manifest")" == "$requested_tag" ]] || return 1
  [[ "$target_version" == "${requested_tag#v}" && "$target_version" == "$task_version" ]] || return 1
  is_release_version "$target_version" || return 1
  [[ "$manifest_commit" =~ ^[0-9a-f]{40}$ ]] || return 1
  verify_release_commit "$requested_tag" "$manifest_commit"
  [[ "$minimum_agent_version" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$(jq -r '.platform' "$manifest")" == 'linux/amd64' ]] || return 1
  [[ "$image_repo" == "$RELEASE_REPOSITORY" && "$image_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  [[ "$jar_name" =~ ^[A-Za-z0-9._-]+\.jar$ && "$jar_sha" =~ ^[0-9a-f]{64}$ && "$jar_size" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$host_package_name" =~ ^[A-Za-z0-9._-]+\.tar\.gz$ && "$host_package_sha" =~ ^[0-9a-f]{64}$ && "$host_package_size" =~ ^[1-9][0-9]*$ ]] || return 1
  release_asset_id "$release_json" "$host_package_name" >/dev/null
  release_asset_id "$release_json" "${host_package_name}.bundle" >/dev/null

  local installed current_digest installed_version
  installed="$RUNTIME_DIR/installed.json"
  current_digest="$(read_release_env_digest || true)"
  installed_version="$(jq -r '.version // empty' "$installed" 2>/dev/null || true)"
  if is_release_version "$installed_version" && is_older_release_version "$target_version" "$installed_version"; then
    echo "Refusing to downgrade from ${installed_version} to ${target_version}." >&2
    return 1
  fi

  if [[ "$update_type" == 'host-package-manual-required' && "$manual_approved" != 'true' && "$initial_install" != 'true' ]]; then
    if [[ "$AUTO_APPLY_HOST_PACKAGE_UPDATES" != 'true' ]]; then
      [[ "$(jq -r '.manual.instructions // .manualInstructions // empty' "$manifest")" != '' ]] || {
        echo 'Manual-required release is missing manual instructions.' >&2
        return 1
      }
      write_status MANUAL_REQUIRED 100 '此版本需要人工更新宿主机依赖' \
        "$(jq -r '[(.manual.reason // ""), (.manual.instructions // .manualInstructions // "请查看 Release 说明。")]
          | map(select(length > 0)) | join(" ")' "$manifest")"
      archive_task
      return 0
    fi
    if (( EUID != 0 )) && [[ "${XIANYU2_UPDATE_AGENT_TEST_MODE:-false}" != 'true' ]]; then
      write_status MANUAL_REQUIRED 100 '自动安装宿主机更新包需要 root 更新代理' \
        '请确认请求由 xianyu2-update-agent.service 处理；不要向应用容器授予宿主机目录或 systemd 权限。'
      archive_task
      return 0
    fi
    auto_apply_host_package_update "$release_json" "$target_version" \
      "$host_package_name" "$host_package_sha" "$host_package_size" \
      "$minimum_agent_version" "$certificate_identity"
    return $?
  fi
  (( agent_version >= minimum_agent_version )) || {
    write_status MANUAL_REQUIRED 100 '更新代理版本过低' \
      '请先验证并安装本 Release 的 host package 和更新代理，再由宿主机管理员重新执行更新。'
    archive_task
    return 0
  }
  if [[ "$update_type" == 'host-package-manual-required' ]]; then
    update_type='image'
  fi
  [[ "$update_type" == 'jar' || "$update_type" == 'image' ]] || return 1

  if [[ "$update_type" == 'jar' ]]; then
    if [[ ! -f "$installed" ]] \
      || [[ -z "$current_digest" || "$current_digest" != "$(jq -r '.imageDigest // empty' "$installed" 2>/dev/null || true)" ]] \
      || [[ "$fingerprint" != "$(jq -r '.runtimeFingerprint // empty' "$installed" 2>/dev/null || true)" ]]; then
      # 运行状态未知时不覆盖 runtime JAR；同一 Release 的不可变镜像是安全的完整恢复路径。
      write_status CHECKING 15 '当前安装状态无法确认，将切换完整镜像基线'
      update_type='image'
    fi
  fi

  if [[ "$update_type" == 'jar' ]]; then
    jar="$download_dir/$jar_name"
    jar_bundle="$download_dir/$jar_name.bundle"
    if ! restore_verified_jar_cache "$target_version" "$jar_name" "$jar_sha" "$jar_size" "$certificate_identity" "$jar"; then
      write_status DOWNLOADING 20 '正在下载应用 JAR'
      download_api_asset "$(release_asset_id "$release_json" "$jar_name")" "$jar" \
        JAR_DOWNLOAD "$jar_size" 20 '正在下载应用 JAR'
      downloaded_bytes="$(stat -c '%s' "$jar")"
      total_bytes="$jar_size"
      [[ "$downloaded_bytes" == "$jar_size" ]] || return 1
      write_status VERIFYING 40 '正在下载并验证 JAR 签名和校验和'
      download_api_asset "$(release_asset_id "$release_json" "$jar_name.bundle")" "$jar_bundle"
      verify_blob "$jar" "$jar_bundle" "$certificate_identity"
      [[ "$(sha256sum "$jar" | awk '{print $1}')" == "$jar_sha" ]] || return 1
      if ! cache_verified_jar "$target_version" "$jar_name" "$jar_sha" "$jar_size" "$certificate_identity" "$jar"; then
        # The cache only saves a future retry. A verified JAR remains safe to install.
        echo 'Unable to populate the verified JAR cache; continuing without a cache entry.' >&2
      fi
    fi
    write_status VERIFYING 45 '正在验证候选镜像签名和来源'
  else
    write_status VERIFYING 40 '正在验证候选镜像签名和来源'
  fi
  run_update_cosign "$DOWNLOAD_TIMEOUT_SECONDS" cosign verify --certificate-identity "$certificate_identity" \
    --certificate-oidc-issuer "$COSIGN_OIDC_ISSUER" "${image_repo}@${image_digest}" >/dev/null
  run_update_cosign "$DOWNLOAD_TIMEOUT_SECONDS" cosign verify-attestation --type slsaprovenance \
    --certificate-identity "$certificate_identity" \
    --certificate-oidc-issuer "$COSIGN_OIDC_ISSUER" "${image_repo}@${image_digest}" >/dev/null

  if consume_cancellation_request; then
    return 1
  fi

  if [[ "$update_type" == 'jar' ]]; then
    backup_if_required "$manifest"
    write_status INSTALLING 65 '正在原子替换运行时 JAR'
    local temporary_jar="$RUNTIME_DIR/.app.jar.${task_id}.tmp"
    if [[ -f "$RUNTIME_DIR/app.jar" ]]; then
      cp "$RUNTIME_DIR/app.jar" "$RUNTIME_DIR/archive/app-${task_id}.jar"
    fi
    cp "$jar" "$temporary_jar"
    mv -f "$temporary_jar" "$RUNTIME_DIR/app.jar"
    write_status RESTARTING 80 '正在重建应用容器'
    app_recreate_started=true
    recreate_app
    wait_for_health
    write_installed_state "$target_version" "$jar_sha" "$fingerprint" "$current_digest" runtime
  else
    write_status INSTALLING 65 '正在切换到新的不可变镜像'
    local previous_release_env="$UPDATE_WORK_DIR/archive/release-env-${task_id}.env"
    local had_previous_release_env=false
    if [[ -f "$RELEASE_ENV_FILE" ]]; then
      cp "$RELEASE_ENV_FILE" "$previous_release_env"
      had_previous_release_env=true
    fi
    # 先以 digest 拉取候选镜像，确认可用后才修改生产 Compose 的受管输入。
    pull_image_with_progress "${image_repo}@${image_digest}"
    if consume_cancellation_request; then
      return 1
    fi
    # pull_image_with_progress clears its transfer telemetry after the daemon
    # reports completion. Publish the next explicit stage before changing the
    # Compose input so the UI never presents this window as an active download.
    write_status INSTALLING 78 '镜像预拉取完成，正在准备容器切换'
    if ! write_release_env "$image_digest"; then
      restore_release_env_snapshot "$previous_release_env" "$had_previous_release_env"
      echo 'Unable to switch release.env; restored the previous release input.' >&2
      return 1
    fi
    if [[ "$initial_install" == 'true' ]] && compose config --services | grep -Fxq mysql; then
      if ! compose up -d --wait mysql; then
        restore_release_env_snapshot "$previous_release_env" "$had_previous_release_env"
        echo 'Unable to start the initial MySQL service; restored the previous release input.' >&2
        return 1
      fi
    fi
    if ! backup_if_required "$manifest"; then
      restore_release_env_snapshot "$previous_release_env" "$had_previous_release_env"
      echo 'Database backup failed; restored the previous release input before starting the app container.' >&2
      return 1
    fi
    if [[ -f "$RUNTIME_DIR/app.jar" ]]; then
      mv -f "$RUNTIME_DIR/app.jar" "$RUNTIME_DIR/archive/app-${task_id}.jar"
    fi
    write_status RESTARTING 80 '正在重建应用容器'
    app_recreate_started=true
    recreate_app
    wait_for_health
    write_installed_state "$target_version" "$jar_sha" "$fingerprint" "$image_digest" baseline
  fi

  write_status SUCCESS 100 '更新完成'
  archive_task
}

create_manual_task() {
  local requested_tag="$1"
  [[ "$requested_tag" =~ $release_tag_pattern ]] || {
    echo "Invalid release tag: $requested_tag" >&2
    return 64
  }
  task_id="$(cat /proc/sys/kernel/random/uuid)"
  task_version="${requested_tag#v}"
  task_started_at="$(timestamp)"
  task_file="$UPDATE_WORK_DIR/in-progress/${task_id}.json"
  jq -n --arg taskId "$task_id" --arg version "$task_version" --arg releaseTag "$requested_tag" \
    --arg requestedAt "$(timestamp)" \
    '{schemaVersion: 1, taskId: $taskId, version: $version, releaseTag: $releaseTag, requestedAt: $requestedAt, manualApply: true}' \
    > "$task_file"
}

main() {
  local manual_tag=''
  local resume_task_id=''
  load_config
  preflight
  case "${1:-}" in
    '') ;;
    --check) exit 0 ;;
    --initial-install) initial_install=true ;;
    --apply-manual-release)
      [[ $# -eq 2 ]] || {
        echo 'Usage: xianyu2-update-agent --apply-manual-release vX.Y.Z' >&2
        exit 64
      }
      manual_tag="$2"
      ;;
    --resume-host-package-update)
      [[ $# -eq 2 ]] || {
        echo 'Usage: xianyu2-update-agent --resume-host-package-update TASK_ID' >&2
        exit 64
      }
      resume_task_id="$2"
      ;;
    *)
      echo "Unsupported argument: $1" >&2
      exit 64
      ;;
  esac
  if [[ -n "$manual_tag" ]]; then
    echo "Received manually confirmed release command for $manual_tag." >&2
  fi

  exec 9>"$UPDATE_WORK_DIR/agent.lock"
  if ! flock -n 9; then
    echo 'Another update agent invocation still holds the update lock.' >&2
    exit 0
  fi
  if [[ -n "$resume_task_id" ]]; then
    resume_self_updated_task "$resume_task_id"
    process_task true
    exit 0
  fi
  local recovery_exit=0
  recover_unfinished_task || recovery_exit=$?
  if (( recovery_exit != 0 )); then
    exit "$recovery_exit"
  fi
  if [[ -n "$manual_tag" ]]; then
    echo "Applying manually confirmed release $manual_tag." >&2
    create_manual_task "$manual_tag"
    process_task true
    exit 0
  fi
  claim_request || exit 0
  process_task false
}

main "$@"
